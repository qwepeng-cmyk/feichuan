ntWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Payload"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"10kg"}]]}],["$","tr","8",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Operating Temperature"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"-20℃~50℃"}]]}],["$","tr","9",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Positioning Accuracy"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"±0.5m"}]]}],["$","tr","10",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Wind Resistance"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Level 6"}]]}],["$","tr","11",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Positioning System"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"GPS/Beidou"}]]}],["$","tr","12",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Protection"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Fail-safe return, Low battery return, Resume from breakpoint"}]]}]]}]]}]}]]}]}],["$","section",null,{"id":"inquiry","className":"detail-section alt","style":{"padding":"80px 0","background":"#f8fafc"},"children":["$","div",null,{"className":"container","style":{"maxWidth":"1200px"},"children":["$","$a",null,{"fallback":["$","div",null,{"style":{"minHeight":"400px","background":"#f8fafc"}}],"children":["$","$L31",null,{"dict":"$e"}]}]}]}]]}]}]}],["$","div",null,{"className":"mobile_only","children":["$","$L32",null,{"product":{"product_name":"电力巡检无人机","product_name_en":"Power Grid Inspection Drone","summary":"电力巡检运维无人机是一款专为输配电线路及电力设施智能化运维设计的专业化巡检系统。系统主要由高可靠性无人机飞行平台、机载巡检载荷和地面控制终端三部分组成。能够在山区、林区等复杂地形高效完成大范围线路普查、杆塔巡检及通道勘测等复杂场景下的立体化巡检与数据采集任务。","summary_en":"The Power Grid Inspection Drone is a professional system designed for the intelligent operation and maintenance of power transmission lines and facilities. It consists of a high-reliability flight platform, airborne inspection payloads, and a ground control terminal. The system efficiently performs large-scale line surveys, tower inspections, and corridor surveys in complex terrains such as mountains and forests, providing 3D inspection and data collection for power infrastructure.","key_application":"应用领域：输配电线路常态化自主巡检；杆塔与变电站设备异常发热、缺陷识别；电力走廊三维建模、树障分析及清障规划。","key_application_en":"Routine autonomous inspection of transmission/distribution lines; identifying abnormal heating and defects in towers/substations; 3D modeling of power corridors and tree barrier analysis.","key_parameter_1":"最大续航时间: 240min（空载）","key_parameter_1_en":"Max Endurance (No Load): 240min","key_parameter_2":"有效作业半径: 50km","key_parameter_2_en":"Effective Operating Radius: 50km","parameters":{"飞行器材料":"先进航空复合材料","起降方式":"垂直起降","动力系统":"纯电动","最大续航时间":"240min（空载）","巡航速度":"65-120km/h","有效作业半径":"50km","最大起飞海拔":"5000m","有效载荷":"10kg","工作温度":"-20℃~50℃","定位精度":"±0.5m","可抗风等级":"6级","定位系统":"GPS/北斗","保护功能":"失控返航、低电量返航降落、断点续飞"},"parameters_en":"{\"Aircraft Material\":\"Advanced Aviation Composites\",\"Take-off/Landing\":\"VTOL (Vertical Take-off and Landing)\",\"Power System\":\"Pure Electric\",\"Max Endurance (No Load)\":\"240min\",\"Cruise Speed\":\"65-120km/h\",\"Effective Operating Radius\":\"50km\",\"Max Take-off Altitude\":\"5000m\",\"Payload\":\"10kg\",\"Operating Temperature\":\"-20℃~50℃\",\"Positioning Accuracy\":\"±0.5m\",\"Wind Resistance\":\"Level 6\",\"Positioning System\":\"GPS/Beidou\",\"Protection\":\"Fail-safe return, Low battery return, Resume from breakpoint\"}","detail_html":"<h4>功能特点</h4><ul><li>电力巡检无人机是一款专为输配电线路及电力设施智能化运维设计的专业化巡检系统。系统主要由高可靠性无人机飞行平台、机载巡检载荷和地面控制终端三部分组成。能够在山区、林区等复杂地形高效完成大范围线路普查、杆塔巡检及通道勘测等复杂场景下的立体化巡检与数据采集任务。</li><li>该系统采用模块化设计，可灵活搭载高清可见光变焦相机、红外热成像仪、激光雷达等专业化载荷，全面覆盖电力巡检的多样化需求。其主要应用场景包括：对高压输电线路开展常态化自主巡检，识别绝缘子破损、导线异物、金具锈蚀等设备缺陷；对变电站及杆塔进行常规化巡视，通过热成像技术快速发现设备异常发热、连接点松动等安全隐患；以及对电力走廊进行三维建模与树障分析，精确测量线路对地距离与交叉跨越安全间距，为线路清障与规划提供数据支持，显著提升电网运维的自动化水平和安全可靠性。</li><li>图1 FC-DLXJ-01无人机</li><li>技术指标</li><li>应用场景</li><li>输电通道实时巡查</li><li>通道巡检-正射/倾斜影像巡检</li><li>通道巡检-激光雷达巡检</li></ul><h4>产品图片</h4>","detail_html_en":"<h4>Features</h4><ul><li>Professional system for power infrastructure O&M. Conducts large-scale surveys and tower inspections in complex terrains.</li><li>Modular design supports HD zoom cameras, thermal sensors, and LiDAR. Key applications: autonomous inspection of high-voltage lines, defect recognition, substation monitoring, and 3D modeling for clearance planning.</li><li>Figure 1 FC-DLXJ-01 Drone</li><li>Technical Specs</li><li>Application Scenarios</li><li>Real-time power channel inspection</li><li>Ortho/Oblique imaging inspection</li><li>LiDAR channel inspection</li></ul>","main_image":"/products/uav-systems/FC-DLXJ-01-Power-Grid-Inspection-Drone.png","handle":"fc-dlxj-01-power-grid-inspection-drone","category_primary":"uav-drone-systems","category_by_flight_platform":"VTOL Fixed-Wing UAVs (复合翼/垂直起降无人机)","category_by_mission_application":"Utility & Pipeline Inspection (电力与油气管线巡检)","product_name_ru":"БПЛА для инспекции электросетей FC-DLXJ-01 (VTOL)","summary_ru":"Профессиональная система, предназначенная для интеллектуальной эксплуатации и обслуживания линий электропередач. Дрон самолетного типа с вертикальным взлетом и посадкой (VTOL) эффективно выполняет задачи по обследованию протяженных маршрутов в горах и лесах, обеспечивая 3D-моделирование коридоров ЛЭП и инспекцию опор.","key_application_ru":"Автономная инспекция распределительных сетей; выявление дефектов и аномального нагрева изоляторов и трансформаторов; анализ растительности в охранных зонах ЛЭП для планирования расчистки.","key_parameter_1_ru":"Время полета (без нагрузки): 240 мин","key_parameter_2_ru":"Рабочий радиус: 50 км","parameters_ru":"{\"Тип платформы\": \"VTOL (Вертикальный взлет и посадка)\", \"Материал корпуса\": \"Авиационные композиты\", \"Время полета (без нагрузки)\": \"240 мин\", \"Рабочий радиус\": \"50 км\", \"Крейсерская скорость\": \"65–120 км/ч\", \"Полезная нагрузка\": \"10 кг\", \"Макс. высота взлета\": \"5000 м\", \"Спутниковые системы\": \"GPS/Beidou\", \"Силовая установка\": \"Чисто электрическая\", \"Рабочая температура\": \"-20°C ~ 50°C\", \"Точность позиционирования\": \"±0.5 м\", \"Сопротивление ветру\": \"Уровень 6\", \"Функции защиты\": \"Возврат при потере связи, возврат при низком заряде, возобновление миссии с точки прерывания\"}","detail_html_ru":"<h4>Особенности и преимущества</h4><ul><li>Гибридная конструкция: Сочетает удобство взлета коптера с высокой скоростью и дальностью полета самолета.</li><li>Высокоточная инспекция: Поддержка LiDAR для создания сверхточных облаков точек и камер с 30-кратным зумом для детального осмотра арматуры опор.</li><li>Экономическая эффективность: Один полет заменяет многодневный обход наземными бригадами в труднодоступной местности.</li><li>Интеллектуальная обработка: Автоматическое выявление опасного сближения веток деревьев с проводами и других угроз безопасности сети.</li></ul>","id":6,"raw_json":"$33","created_at":"2026-05-07 15:56:24","updated_at":"2026-05-07 15:56:24"},"locale":"en","dict":"$e"}]}]]

33:T2b5c,{
  "product_name": "FC6550D双源双视角安检机",
  "product_name_en": "Dual-View X-Ray Baggage Scanner FC6550D",
  "summary": "FC6550D 安检机是一款采用双视角检查系统的高端安检设备。它利用双能量两组射线源探测器及数字图像处理系统，从垂直和水平两个方向同步对物品进行检测，无需考虑被检物品的摆放摆放位置即可获得极其清晰鲜明的图像。相比传统 X 射线设备，它在检查效率、空间利用率及减少误报漏报方面具有显著优势。设备支持物质识别功能，能精准分辨有机物、无机物和混合物，并具备辅助自动识别爆炸物与毒品的功能，为机场、海关及重要交通枢纽提供全方位的安全保障。",
  "summary_en": "The FC6550D X-ray scanner features a high-end dual-view inspection system, utilizing dual-energy X-ray sources and digital image processing to scan items from both vertical and horizontal directions simultaneously. This allows for exceptionally clear and vivid imaging regardless of how items are placed on the conveyor. Compared to traditional single-view equipment, the FC6550D offers significant advantages in throughput efficiency, station space utilization, and the reduction of false alarms or missed detections. With advanced material discrimination capabilities to distinguish between organic, inorganic, and metallic substances, and assisted identification for explosives and narcotics, it provides comprehensive security for airports, customs, and critical transportation hubs.",
  "key_application": "应用领域：FC6550D双源双视角安检机；双视角同步检测，无需考虑摆放位置。高清图像穿透力强，具备爆炸物/毒品辅助检查与AI智能判图功能。",
  "key_application_en": "Dual-view vertical/horizontal scanning for zero blind spots; high-throughput 270kg load capacity; assisted AI detection for explosives and narcotics; advanced material identification (organic/inorganic/mixed).",
  "key_parameter_1": "通道尺寸: 650mm(宽）*500mm（高）",
  "key_parameter_1_en": "Tunnel Size: 650mm(W) x 500mm(H)",
  "key_parameter_2": "穿透力: 底照视角/侧照视角 46mm 钢板",
  "key_parameter_2_en": "Penetration: 46mm steel plate (Both views)",
  "parameters": {
    "外形尺寸": "1690mm(L) x 1348mm(W) x 1331mm(H) (不含接物架)",
    "通道尺寸": "650mm(W) x 500mm(H)",
    "传送带额定负荷": "270 kg",
    "穿透力": "46mm 钢板 (底照/侧照双视角相同)",
    "分辨率": "线分辨力 Φ0.0787mm，空间分辨力 Φ0.8mm",
    "技术特点": "多能量 X 射线检查、物质识别 (有机/无机/混合)、AI 智能判图",
    "显示系统": "双高清液晶显示屏，24位真彩色，1-64倍无极放大",
    "报警功能": "爆炸物/毒品自动探测标记、可疑物品声光报警",
    "辐射安全": "泄露射线剂量率 0.03μGy/h (优于健康安全标准)",
    "结构设计": "国标 304 不锈钢机架，防夹手保护装置，节能感应运行"
  },
  "parameters_en": {
    "External Dimensions": "1690mm(L) x 1348mm(W) x 1331mm(H)",
    "Tunnel Size": "650mm(W) x 500mm(H)",
    "Max Conveyor Load": "270 kg",
    "Penetration": "46mm steel plate (Dual-View)",
    "Resolution": "Wire: Φ0.0787mm; Spatial: Φ0.8mm",
    "Technical Features": "Dual-energy scanning; Material ID; AI-assisted analysis",
    "Display System": "Dual HD monitors; 24-bit color; 1-64x zoom",
    "Alarm Functions": "Auto detection for explosives/narcotics; Audio-visual alerts",
    "Radiation Safety": "Leakage < 0.03μGy/h (Superior to safety standards)",
    "Structure and Build": "304 stainless steel frame; anti-pinch protection; smart-energy mode"
  },
  "detail_html": "<h4>功能特点</h4><ul><li>Product Features</li><li>★新颖技术：数据采用并行传输技术，较其他同类产品网络传输的速度快10-20倍，高清图像、强穿透力、高分辨力、强大物质识别功能</li><li>★易学易用：采用简洁、人性化的操作界面，让用户轻松使用设备</li><li>★高清显示：高分辨率双液晶显示屏，独立双屏幕操作台，方便操作人员办公</li><li>★AI智能判图功能：安检机应能对被检物品形状进行自动判断，精确快速识别刀具、枪支、危险液体、烟花爆竹等危险违禁物品，可对物品智能圈出文字显示、语音提示、声光报警（选配功能）</li><li>★节能环保：机器可以自动感应物体，有行李放上机器才启动运行，无物体时静止</li><li>★一键关机：关机时只需旋转一下钥匙，设备自动安全关机，减少设备故障</li><li>★环保设计：铅帘外加保护膜，防止客人手接触铅，避免铅污染</li><li>★动态画面切换：画面在静止的时候可以切换，在动态的时候也可以自如切换</li><li>★自动报警功能：遇到危险物品、穿不透物品会自动报警</li><li>★稳定可靠：产品生产过程严格按照ISO9001质量管理体系进行管控，通过严格的高低温试验、湿热试验和震 动试验，确保产品无故障连续运行10000小时以上。</li><li>★稳固机架：选用国标304不锈钢、2-3mm国标冷轧板及方通钢材，融合工业先进技术，结构设计稳定牢固、防锈防腐防线缆损伤。</li><li>★服务保障：24小时售后电话随时为客户提供技术支持，服务团队分部全国各地，提供安装、维修检修服务。</li></ul>",
  "detail_html_en": "<h4>Features</h4><ul><li>Dual-source, dual-view X-ray inspection system providing two simultaneous scanning perspectives.</li><li>Eliminates blind spots inherent in single-view systems, significantly improving threat detection rates.</li><li>High-resolution imaging with automatic material discrimination (organic, inorganic, mixture).</li><li>Tunnel size 650mm(W)×500mm(H), suitable for medium to large baggage and parcels.</li><li>Advanced image processing: zoom, edge enhancement, pseudo-color, high/low penetration switching, organic stripping.</li><li>Supports network connectivity for centralized monitoring and image storage.</li><li>TIP (Threat Image Projection) function for operator training and performance assessment.</li><li>Compliant with GB15208-2005 and international radiation safety standards.</li></ul>",
  "main_image": "/products/security/FC6550D-Dual-View-X-Ray-Scanner.png",
  "handle": "fc6550d-dual-view-baggage-scanner",
  "category_primary": "Security Screening & Policing (安检 with 智慧警务装备)",
  "category_secondary": "X-Ray Baggage & Parcel Scanners (X光行李/物品安检机 - 含双视角/小型机)",
  "category_tertiary": "Dual-View Scanners (双视角安检机)",
  "product_name_ru": "Двухпроекционный рентгеновский интроскоп FC6550D",
  "summary_ru": "FC6550D — это высокотехнологичная установка, использующая систему двухпроекционного досмотра (Dual-View). Благодаря двум независимым источникам излучения и цифровой системе обработки, прибор одновременно сканирует объект в вертикальной и горизонтальной плоскостях. Это позволяет получать четкие изображения независимо от расположения багажа на ленте. По сравнению с обычными аппаратами, FC6550D значительно повышает эффективность досмотра и снижает вероятность пропуска угроз. Система поддерживает распознавание материалов (органика/неорганика/металлы) и автоматический поиск взрывчатых веществ и наркотиков.",
  "key_application_ru": "Синхронное сканирование в двух проекциях (вертикальной и горизонтальной) для исключения слепых зон; нагрузка до 270 кг; интеллектуальный анализ ИИ.",
  "key_parameter_1_ru": "Размер туннеля: 650(Ш) x 500(В) мм",
  "key_parameter_2_ru": "Проникающая способность: 46 мм сталь",
  "parameters_ru": {
    "Габаритные размеры": "1690(Д) x 1348(Ш) x 1331(В) мм (без приемного лотка)",
    "Размер туннеля": "650(Ш) x 500(В) мм",
    "Максимальная нагрузка": "270 кг",
    "Проникающая способность": "46 мм сталь (в обеих проекциях)",
    "Разрешение": "Проволока Φ0.0787 мм; Пространственное Φ0.8 мм",
    "Технические особенности": "Мультиэнергетическое сканирование, распознавание материалов, анализ ИИ",
    "Система отображения": "Два HD ЖК-монитора, 24-битный цвет, зум 1-64x",
    "Функции тревоги": "Автоматическое обнаружение ВВ/наркотиков, светозвуковой сигнал",
    "Радиационная безопасность": "Доза утечки 0.03 мкГр/ч (превосходит стандарты безопасности)",
    "Конструкция": "Рама из нержавеющей стали 304, защита от защемления, энергосберегающий режим"
  },
  "detail_html_ru": "<h4>Особенности и преимущества</h4><ul><li>Инновационные технологии: Параллельная передача данных в 10-20 раз быстрее аналогов, высокая проникающая способность и четкость.</li><li>Два экрана: Независимая консоль с двумя мониторами для максимального удобства оператора.</li><li>Интеллектуальный анализ ИИ: Автоматическое распознавание ножей, оружия, опасных жидкостей и пиротехники с выделением контуров на экране и голосовым оповещением.</li><li>Энергосбережение: Автоматическое включение конвейера только при наличии багажа.</li><li>Надежность: Спроектирован для бесперебойной работы более 10 000 часов в сложных условиях.</li><li>Прочная рама: Использование нержавеющей стали 304 и холоднокатаных листов для защиты от коррозии.</li></ul>"
}b:[["$","div",null,{"className":"pc_only","children":["$","div",null,{"className":"product-detail-page","style":{"paddingTop":"112px"},"children":["$","main",null,{"children":[["$","div",null,{"className":"product-breadcrumb-nav","children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"breadcrumb-path","children":[["$","$L2d",null,{"href":"/en","children":"Home"}]," > ",["$","$L2d",null,{"href":"/en/products","children":"Products"}]," > ","Dual-View X-Ray Baggage Scanner FC6550D"]}]}]}],["$","section",null,{"id":"overview","className":"product-hero","style":{"padding":"40px 0 20px","background":"#fff"},"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"product-grid","style":{"display":"grid","gridTemplateColumns":"1.2fr 1fr","gap":"80px","alignItems":"start"},"children":[["$","div",null,{"className":"gallery-main-area","children":["$","$L2e",null,{"images":["/products/security/FC6550D-Dual-View-X-Ray-Scanner.png"]}]}],["$","div",null,{"className":"product-info","children":[["$","h1",null,{"style":{"fontSize":"4.8rem","fontWeight":"900","marginBottom":"20px","lineHeight":"1.1","color":"#333"},"children":"Dual-View X-Ray Baggage Scanner FC6550D"}],["$","div",null,{"className":"drone-specs","style":{"marginBottom":"40px"},"children":[["$","div",null,{"style":{"fontSize":"1.8rem","color":"#525a66","marginBottom":"8px","lineHeight":"1.4"},"children":"Tunnel Size: 650mm(W) x 500mm(H)"}],["$","div",null,{"style":{"fontSize":"1.8rem","color":"#525a66","marginBottom":"8px","lineHeight":"1.4"},"children":"Penetration: 46mm steel plate (Both views)"}],["$","div",null,{"style":{"fontSize":"1.8rem","color":"#525a66","lineHeight":"1.4"},"children":"Dual-view vertical/horizontal scanning for zero blind spots; high-throughput 270kg load capacity; assisted AI detection for explosives and narcotics; advanced material identification (organic/inorganic/mixed)."}]]}],["$","div",null,{"className":"cta-group","
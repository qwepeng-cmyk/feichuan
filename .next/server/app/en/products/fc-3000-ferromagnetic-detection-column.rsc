le":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Dual-column linking for hierarchical warnings (Lighter/Phone/Knife differentiation)"}]]}],["$","tr","6",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Throughput Flux"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"> 60 persons/minute"}]]}],["$","tr","7",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Coverage"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"0 - 1.5 meter radius with 360-degree omnidirectional sensing"}]]}],["$","tr","8",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Industrial Rating"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"IP65 Weatherproof; suitable for indoor/outdoor use"}]]}],["$","tr","9",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Material/Portability"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"High-strength aluminum alloy;柱身 5.9kg (Lightweight column)"}]]}],["$","tr","10",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Dimensions"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Column Height: 180cm; Base Height: 7cm"}]]}],["$","tr","11",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Endurance"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Internal Li-battery supports > 24 hours of operation; Type-C charging"}]]}]]}]]}]}]]}]}],["$","section",null,{"id":"inquiry","className":"detail-section alt","style":{"padding":"80px 0","background":"#f8fafc"},"children":["$","div",null,{"className":"container","style":{"maxWidth":"1200px"},"children":["$","$a",null,{"fallback":["$","div",null,{"style":{"minHeight":"400px","background":"#f8fafc"}}],"children":["$","$L31",null,{"dict":"$e"}]}]}]}]]}]}]}],["$","div",null,{"className":"mobile_only","children":["$","$L32",null,{"product":{"product_name":"FC-3000 智能铁磁探测系统","product_name_en":"Intelligent Ferromagnetic Detection System FC-3000","summary":"FC-3000智能铁磁探测系统是一款被动式探测铁磁性物质的设备，拥有世界领先的磁通门检测、DSP数字信号处理等核心技术，通过智能软件算法排除周围环境干扰的限制因素，FC-3000是便携的、安全的、可信任的产品。","summary_en":"The FC-3000 Intelligent Ferromagnetic Detection System is a passive detection device for ferromagnetic materials, with world-leading fluxgate detection and DSP digital signal processing core technologies. Through intelligent software algorithms, it eliminates the limiting factors of surrounding environmental interference. The FC-3000 is a portable, safe, and trustworthy product.","key_application":"应用领域：FC-3000 智能铁磁探测系统；被动式无源探测，无电磁辐射；高灵敏度识别各类磁性违禁品；支持隐蔽筛查与联网分级预警。","key_application_en":"Passive electromagnetic-safe ferromagnetic detection; nanotesla-level sensitivity for hidden metals; 3-zone positioning for precise identification; discrete/covert screening capable; high-throughput 60+ ppm.","key_parameter_1":"探测灵敏度: 纳特斯拉 (nT) 级","key_parameter_1_en":"Sensitivity: Nanotesla (nT) Level","key_parameter_2":"电池续航: ≥ 24 小时 (内置大容量锂电)","key_parameter_2_en":"Battery Life: ≥ 24 Hours (Internal Li-ion)","parameters":{"探测技术":"被动式磁通门检测 + 高性能 DSP 处理","识别能力":"精准探测含磁性金属及非金属 (铁、钴、镍及合金)","安全性":"无源探测，不产生电磁辐射，通过 CE/QMS 认证","警报模式":"可视化智能报警 (红/绿灯)、声音报警、可选隐蔽报警 (智能手表联接)","定位功能":"铁磁物品三分区定位显示","联网模式":"双柱联网支持分级预警 (打火机/手机/管制刀具区分)","通过效率":"＞ 60 人次/每分钟","探测范围":"半径 0 - 1.5 米 360 度全方位覆盖","防护等级":"IP65 级防水防尘","结构材质":"轻量化高强度铝合金柱身","整机重量":"柱身 5.9kg，底座 15.8kg","尺寸规格":"柱身高度 180cm，底座高度 7cm"},"parameters_en":"{\"Technology\":\"Passive Fluxgate Detection with High-Performance DSP Processing\",\"Detection Targets\":\"Precisely scans for ferromagnetic metals/non-metals (Iron, Cobalt, Nickel)\",\"Radiation Safety\":\"Passive sensing only; zero EM emission; certified CE/QMS\",\"Alarm Interface\":\"Visual alerts (Red/Green), high-fidelity audio, and optional discreet vibrating watch link\",\"Spatial Resolution\":\"3-zone vertical positioning for accurate item localization\",\"Intelligent Networking\":\"Dual-column linking for hierarchical warnings (Lighter/Phone/Knife differentiation)\",\"Throughput Flux\":\"> 60 persons/minute\",\"Coverage\":\"0 - 1.5 meter radius with 360-degree omnidirectional sensing\",\"Industrial Rating\":\"IP65 Weatherproof; suitable for indoor/outdoor use\",\"Material/Portability\":\"High-strength aluminum alloy;柱身 5.9kg (Lightweight column)\",\"Dimensions\":\"Column Height: 180cm; Base Height: 7cm\",\"Endurance\":\"Internal Li-battery supports > 24 hours of operation; Type-C charging\"}","detail_html":"<h4>产品功能</h4><ul><li>检测含磁性的金属和非金属物品。</li><li>非接触式无源探测，低功耗，不发射有害电磁波。</li><li>实时、可视化智能报警。</li><li>灵敏度高，NT级，检测铁磁物品三分区定位。</li><li>检测范围宽，0-1.5米以此为半径的360度范围。</li><li>通过速率高，＞60人次/每分钟。</li><li>隐蔽筛查，可放置在物体、门及墙后，可配合智能手表报警，外形可根据安检场所进行隐蔽设计。</li><li>内置大容量锂电池可正常运行＞24小时。</li><li>双柱联网模式：分级预警功能。（打火机等蓝灯、手机黄灯、管制类刀具红灯）</li></ul>","detail_html_en":"<h4>Product Functions</h4><ul><li>Detects metallic and non-metallic items containing ferromagnetic material.</li><li>Non-contact passive detection, low power consumption, emits no harmful electromagnetic waves.</li><li>Real-time, visualized intelligent alarm.</li><li>High sensitivity, NT level, three-zone positioning for detected ferromagnetic items.</li><li>Wide detection range, 360-degree coverage within a 0-1.5 meter radius.</li><li>High throughput rate, >60 persons/minute.</li><li>Covert screening, can be placed behind objects, doors and walls, can be paired with smart watch for alarm, appearance can be designed for concealment according to security venue.</li><li>Built-in large-capacity lithium battery, normal operation >24 hours.</li><li>Dual-column network mode: hierarchical warning function. (Lighter: blue light, phone: yellow light, controlled knives: red light)</li></ul>","main_image":"/products/anti-drone/FC-3000-Intelligent-Ferromagnetic-Detection-System.png","handle":"fc-3000-ferromagnetic-detection-column","category_primary":"security-screening","category_secondary":"Safety Inspection Gates (安检门/探测门)","category_tertiary":"Ferromagnetic Detection Systems (铁磁探测柱系统)","product_name_ru":"Интеллектуальная система ферромагнитного детектирования FC-3000","summary_ru":"FC-3000 — это пассивная система обнаружения ферромагнитных материалов, использующая ведущие мировые технологии феррозондового детектирования и цифровой обработки сигналов DSP. Благодаря интеллектуальным алгоритмам система эффективно отсеивает фоновые помехи, обеспечивая надежный и безопасный досмотр в портативном исполнении.","key_application_ru":"Пассивное электромагнитно-безопасное детектирование; чувствительность наноуровня (нТл); 3 зоны позиционирования; возможность скрытого размещения.","key_parameter_1_ru":"Чувствительность: Наноуровень (нТл)","key_parameter_2_ru":"Автономность: ≥ 24 часа","parameters_ru":"{\"Технология\":\"Пассивное феррозондовое детектирование + высокопроизводительная обработка DSP\",\"Объекты обнаружения\":\"Точный поиск металлов и неметаллов с ферромагнитными свойствами (железо, кобальт, никель и сплавы)\",\"Безопасность\":\"Пассивное сканирование, отсутствие собственного электромагнитного излучения\",\"Режимы тревоги\":\"Визуальная индикация (красный/зеленый), звуковой сигнал, опциональная скрытая тревога через смарт-часы\",\"Локализация\":\"Отображение места нахождения предмета в трех вертикальных зонах\",\"Сетевой режим\":\"Возможность объединения двух колонн для дифференциации угроз (зажигалка/телефон/нож)\",\"Пропускная способность\":\"> 60 человек в минуту\",\"Радиус охвата\":\"От 0 до 1.5 метров, круговой обзор 360°\",\"Класс защиты\":\"IP65 (водонепроницаемость и пылезащита)\",\"Материал корпуса\":\"Легкий и прочный алюминиевый сплав\",\"Вес\":\"Стойка 5.9 кг, основание 15.8 кг\",\"Размеры\":\"Высота стойки 180 см, высота основания 7 см\",\"Автономность\":\"Более 24 часов от встроенного аккумулятора, зарядка Type-C\"}","detail_html_ru":"<h4>Функциональные возможности</h4><ul><li>Детектирование: Обнаружение любых предметов, содержащих ферромагнитные элементы.</li><li>Экологичность: Не излучает вредных волн, безопасен для всех категорий граждан.</li><li>Сверхвысокая чувствительность: Уровень нанотесла (нТл) с точным указанием зоны нахождения предмета.</li><li>Скрытый досмотр: Возможность размещения за дверями, стенами или предметами интерьера.</li><li>Интеллектуальное оповещение: Синхронизация со смарт-часами для бесшумного уведомления охраны.</li><li>Автономная работа: Более суток непрерывной эксплуатации без подзарядки.</li></ul>","id":41,"raw_json":"$33","created_at":"2026-05-07 15:56:24","updated_at":"2026-05-07 15:56:24"},"locale":"en","dict":"$e"}]}]]

ntact us"}]}],["$","section",null,{"id":"features","className":"detail-section alt","style":{"padding":"100px 0","backgroundColor":"#f8fafc"},"children":["$","div",null,{"className":"container","children":["$","$L30",null,{"className":"rich-content auto-grid","html":"<h4>Features</h4><ul><li>Non-contact, non-opening detection: identifies hazardous liquids through sealed containers without opening, safe and fast.</li><li>Broad applicability: detects flammable, explosive, corrosive, and toxic liquids in glass, plastic, ceramic, and other non-metallic containers.</li><li>Wide container compatibility: supports various container wall thicknesses from 1-10mm.</li><li>Rapid detection: single test completes within 2 seconds.</li><li>Intuitive result display: large color LCD screen with clear pass/alarm indication and audio-visual alerts.</li><li>Automatic calibration: built-in self-calibration function to ensure measurement accuracy.</li><li>Portable design: compact and lightweight, suitable for checkpoint and mobile inspection use.</li></ul>"}]}]}],["$","section",null,{"id":"specs","className":"detail-section","style":{"padding":"80px 0","backgroundColor":"#fff"},"children":["$","div",null,{"className":"container","children":[["$","h2",null,{"className":"section-title","style":{"textAlign":"center","marginBottom":"50px","fontSize":"3.6rem","fontWeight":700},"children":"Technical Specifications"}],["$","div",null,{"style":{"border":"1px solid #eee","overflowX":"auto"},"children":["$","table",null,{"className":"spec-table","style":{"width":"100%","borderCollapse":"collapse","minWidth":"600px"},"children":[["$","thead",null,{"children":["$","tr",null,{"style":{"background":"#f4f7fa","color":"#333","borderBottom":"2px solid #315ba4"},"children":[["$","th",null,{"style":{"padding":"20px 30px","textAlign":"left","fontSize":"1.6rem","fontWeight":"bold"},"children":"Parameter"}],["$","th",null,{"style":{"padding":"20px 30px","textAlign":"left","fontSize":"1.6rem","fontWeight":"bol
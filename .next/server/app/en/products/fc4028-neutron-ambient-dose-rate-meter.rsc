    "Power Consumption": "Entire unit ≤200mW (excluding display backlight)",
    "Operating Time": "Over 24 hours continuous operation with host when buzzer and backlight are off",
    "Operating Temperature": "-41℃ to +50℃",
    "Storage Temperature": "-41℃ to +50℃",

"#f8fafc"},"children":["$","div",null,{"className":"container","children":["$","$L30",null,{"className":"rich-content auto-grid","html":"<h4>Key Features</h4><ul><li>Handheld integrated detection and jamming system, ultra-portable for single-person operation.</li><li>Built-in SDR (Software Defined Radio) technology for real-time drone signal detection.</li><li>Multi-band jamming capability covering all mainstream drone communication frequencies.</li><li>Automatic detection-to-jamming workflow, minimizing operator workload.</li><li>Effective detection range up to 2km, effective jamming range up to 1.5km.</li><li>Ergonomic gun-type design with intuitive point-and-shoot operation.</li><li>Built-in rechargeable battery supporting continuous operation for extended periods.</li><li>Lightweight design under 5kg for comfortable extended use.</li></ul>"}]}]}],["$","section",null,{"id":"specs","className":"detail-section","style":{"padding":"80px 0","backgroundColor":"#fff"},"children":["$","div",null,{"className":"container","children":[["$","h2",null,{"className":"section-title","style":{"textAlign":"center","marginBottom":"50px","fontSize":"3.6rem","fontWeight":700},"children":"Technical Specifications"}],["$","div",null,{"style":{"border":"1px solid #eee","overflowX":"auto"},"children":["$","table",null,{"className":"spec-table","style":{"width":"100%","borderCollapse":"collapse","minWidth":"600px"},"children":[["$","thead",null,{"children":["$","tr",null,{"style":{"background":"#f4f7fa","color":"#333","borderBottom":"2px solid #315ba4"},"children":[["$","th",null,{"style":{"padding":"20px 30px","textAlign":"left","fontSize":"1.6rem","fontWeight":"bold"},"children":"Parameter"}],["$","th",null,{"style":{"padding":"20px 30px","textAlign":"left","fontSize":"1.6rem","fontWeight":"bold"},"children":"Description"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20p
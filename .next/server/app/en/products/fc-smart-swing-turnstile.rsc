inTop":"40px"},"children":[["$","a",null,{"href":"#inquiry","className":"btn-cta","style":{"background":"#ff9800","color":"#fff","borderRadius":"4px","fontSize":"2rem","flex":1,"height":"60px","border":"none","cursor":"pointer","display":"flex","alignItems":"center","justifyContent":"center","fontWeight":"700","textDecoration":"none"},"children":"Get quotation"}],["$","a",null,{"href":"https://wa.me/+8613761974616","className":"btn-cta","style":{"background":"#ff9800","color":"#fff","borderRadius":"4px","fontSize":"2rem","flex":1,"height":"60px","display":"flex","alignItems":"center","justifyContent":"center","border":"none","fontWeight":"700","textDecoration":"none"},"children":"WhatsApp"}]]}]]}]]}]}]}],["$","section",null,{"className":"product-intro-section","style":{"paddingBottom":"60px","background":"#fff"},"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"product-intro-text","style":{"fontSize":"1.8rem","color":"#444","lineHeight":"1.8","borderTop":"1px solid #eee","paddingTop":"40px"},"children":"The Deluxe Smart Swing Turnstile is constructed from premium SUS304 stainless steel with a robust 1.5mm thickness. Utilizing high-precision laser cutting technology, it features a sleek and clean exterior free from common defects such as burrs, scratches, or sharp edges. The system is driven by a brushless DC motor and a specialized anti-collision core, boasting a Mean Time Between Failures (MTBF) of over 8 million cycles. It supports a wide transit width of up to 110cm and includes a triple anti-pinch mechanism (mechanical, current, and electronic) to ensure maximum pedestrian safety. With integrated LED atmospheric lighting, custom voice prompts, and full fire linkage support, it represents a state-of-the-art solution for professional access control in high-traffic commercial and public environments."}]}]}],["$","$L2f",null,{"items":[{"id":"overview","label":"Overview"},{"id":"specs","label":"Technical Specifications"},{"id":"inquiry","label":"Contact us"}]}],["$","section",null,{"id":"features","className":"detail-section alt","style":{"padding":"100px 0","backgroundColor":"#f8fafc"},"children":["$","div",null,{"className":"container","children":["$","$L30",null,{"className":"rich-content auto-grid","html":"$31"}]}]}],["$","section",null,{"id":"specs","className":"detail-section","style":{"padding":"80px 0","backgroundColor":"#fff"},"children":["$","div",null,{"className":"container","children":[["$","h2",null,{"className":"section-title","style":{"textAlign":"center","marginBottom":"50px","fontSize":"3.6rem","fontWeight":700},"children":"Technical Specifications"}],["$","div",null,{"style":{"border":"1px solid #eee","overflowX":"auto"},"children":["$","table",null,{"className":"spec-table","style":{"width":"100%","borderCollapse":"collapse","minWidth":"600px"},"children":[["$","thead",null,{"children":["$","tr",null,{"style":{"background":"#f4f7fa","color":"#333","borderBottom":"2px solid #315ba4"},"children":[["$","th",null,{"style":{"padding":"20px 30px","textAlign":"left","fontSize":"1.6rem","fontWeight":"bold"},"children":"Parameter"}],["$","th",null,{"style":{"padding":"20px 30px","textAlign":"left","fontSize":"1.6rem","fontWeight":"bold"},"children":"Description"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Chassis Thickness"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"1.5mm SUS304 Stainless Steel shell"}]]}],["$","tr","1",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Passage Width"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Supports widths up to 110 cm"}]]}],["$","tr","2",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Drive System"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Brushless DC motor with helical anti-collision drive core"}]]}],["$","tr","3",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Durability"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"MTBF ≥ 8 million cycles; smooth acceleration/deceleration control"}]]}],["$","tr","4",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Safety Systems"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Triple anti-pinch protection (Mechanical/Current/Optical); Anti-tailgate logic"}]]}],["$","tr","5",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Opening Speed"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Adjustable in 10 steps; ≥0.8s minimum"}]]}],["$","tr","6",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Emergency"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Fire alarm linkage (Auto-open) and power-failure free-swing mode"}]]}],["$","tr","7",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Human Interaction"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Integrated LED passage indicators, atmospheric lights, and customized voice feedback"}]]}],["$","tr","8",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Industrial Standards"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Precision laser cutting; IP-rated waterproof and dustproof treatment"}]]}],["$","tr","9",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Operation Noise"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Smooth operation noise ≤ 65dB"}]]}],["$","tr","10",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Dimensions"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"1400mm * 180mm * 1000mm"}]]}]]}]]}]}]]}]}],["$","section",null,{"id":"inquiry","className":"detail-section alt","style":{"padding":"80px 0","background":"#f8fafc"},"children":["$","div",null,{"className":"container","style":{"maxWidth":"1200px"},"children":["$","$a",null,{"fallback":["$","div",null,{"style":{"minHeight":"400px","background":"#f8fafc"}}],"children":["$","$L32",null,{"dict":"$e"}]}]}]}]]}]}]}],["$","div",null,{"className":"mobile_only","children":["$","$L33",null,{"product":{"product_name":"豪华智能摆闸","product_name_en":"Deluxe Smart Swing Turnstile","summary":"豪华智能摆闸采用优质 SUS304 不锈钢材质，整机厚度达 1.5mm，通过激光切割工艺打造靓丽且平整的外观，无飞边毛刺等缺陷。该设备搭载直流无刷电机与螺旋旋齿防撞驱动机芯，平均无故障运行次数（MTBF）不小于 800 万次。闸机支持宽达 110cm 的通道宽度，并具备机械、电流、电子三重防夹技术与消防联动功能，集成语音播报、LED 氛围灯及通行指示系统，是高端场所人行通道管控的理想选择。","summary_en":"The Deluxe Smart Swing Turnstile is constructed from premium SUS304 stainless steel with a robust 1.5mm thickness. Utilizing high-precision laser cutting technology, it features a sleek and clean exterior free from common defects such as burrs, scratches, or sharp edges. The system is driven by a brushless DC motor and a specialized anti-collision core, boasting a Mean Time Between Failures (MTBF) of over 8 million cycles. It supports a wide transit width of up to 110cm and includes a triple anti-pinch mechanism (mechanical, current, and electronic) to ensure maximum pedestrian safety. With integrated LED atmospheric lighting, custom voice prompts, and full fire linkage support, it represents a state-of-the-art solution for professional access control in high-traffic commercial and public environments.","key_application":"应用领域：豪华智能摆闸；高品质 SUS304 不锈钢材质，具备 MTBF ≥ 800 万次超长寿命与三重防夹防护，广泛应用于各类建筑出入口。","key_application_en":"Premium access control for high-traffic public areas; SUS304 stainless steel with 1.5mm thickness; MTBF ≥ 8 million cycles; wide transit width (≤110cm) with triple anti-pinch safety.","key_parameter_1":"材质规格: SUS304不锈钢，厚度1.5mm","key_parameter_1_en":"Construction: SUS304 Stainless Steel, 1.5mm thickness","key_parameter_2":"可靠性: MTBF ≥ 800 万次","key_parameter_2_en":"Reliability: MTBF ≥ 8 million cycles","parameters":{"整机厚度":"1.5mm SUS304 不锈钢外壳","通道宽度":"支持 ≤ 110 cm (超大件通过能力)","驱动/机芯":"直流无刷电机 + 螺旋旋齿防撞驱动机芯","运行寿命":"MTBF ≥ 800 万次，支持匀加减速平稳运动","安全特性":"机械、电流、电子三重防夹保护；光学传感器防尾随/防反向","开闸速度":"≥ 0.8s，支持 10 档调速","应急模式":"支持消防联动 (感应后开闸) 与断电自动解锁功能","交互系统":"LED 通行指示灯、氛围灯及自定义语音播报模块","工业标准":"激光精密切割，IP 防水防尘处理","运行噪音":"平顺运转噪音 ≤ 65dB","外部尺寸":"1400mm * 180mm * 1000mm"},"parameters_en":"{\"Chassis Thickness\":\"1.5mm SUS304 Stainless Steel shell\",\"Passage Width\":\"Supports widths up to 110 cm\",\"Drive System\":\"Brushless DC motor with helical anti-collision drive core\",\"Durability\":\"MTBF ≥ 8 million cycles; smooth acceleration/deceleration control\",\"Safety Systems\":\"Triple anti-pinch protection (Mechanical/Current/Optical); Anti-tailgate logic\",\"Opening Speed\":\"Adjustable in 10 steps; ≥0.8s minimum\",\"Emergency\":\"Fire alarm linkage (Auto-open) and power-failure free-swing mode\",\"Human Interaction\":\"Integrated LED passage indicators, atmospheric lights, and customized voice feedback\",\"Industrial Standards\":\"Precision laser cutting; IP-rated waterproof and dustproof treatment\",\"Operation Noise\":\"Smooth operation noise ≤ 65dB\",\"Dimensions\":\"1400mm * 180mm * 1000mm\"}","detail_html":"<h4>功能特点</h4><ul><li>SUS304 航空级工艺：机身选用加厚不锈钢，配合激光无缝焊接技术，即使在户外高盐雾环境下也能提供卓越的抗腐蚀与抗冲击能力。</li><li>极致通行效率：无刷电机驱动确保闸门在 0.8 秒内极速响应，配合可调档位，大幅提升早晚高峰期人员流转速度。</li><li>全方位行人保障：集成光学传感器防夹与碰撞自动停机算法，并支持消防联动及断电自动复位，确保紧急时刻通道畅通。</li><li>智能反潜回与防尾随：精密的红外探测矩阵能够识别最小 100mm 间隔的尾随行为，并实时触发语音警报与数据上传。</li><li>奢华视觉指示：前端顶盖配备三色柔光 LED 指示灯，支持绿行、红止、黄警示等多种灯语，增强场馆高级感。</li><li>免维护高寿命：机芯 MTBF 超 800 万次，配合自诊断报警系统，显著降低长期物管维护成本。</li><li>Figure 1 Deluxe Smart Turnstile</li></ul>","detail_html_en":"$34","main_image":"/products/security/Deluxe-Smart-Turnstile.png","handle":"fc-smart-swing-turnstile","category_primary":"security-screening","category_secondary":"Access Control Turnstiles (通道闸机 / 摆闸)","product_name_ru":"Интеллектуальный турникет-калитку класса люкс","summary_ru":"Турникет-калитку класса люкс изготовлен из высококачественной нержавеющей стали SUS304 толщиной 1.5 мм. Использование лазерной резки обеспечивает идеально ровную поверхность без заусенцев и дефектов. Оснащен бесколлекторным двигателем постоянного тока и механизмом с защитой от столкновений. Наработка на отказ (MTBF) составляет не менее 8 миллионов циклов. Поддерживает ширину прохода до 110 см и тройную систему защиты от защемления, являясь идеальным решением для управления доступом в премиальных локациях.","key_application_ru":"Контроль доступа премиум-класса; нержавеющая сталь SUS304 (1.5 мм); MTBF ≥ 8 млн циклов; ширина прохода до 110 см; тройная защита от защемления.","key_parameter_1_ru":"Материал: Нержавеющая сталь SUS304 (1.5 мм)","key_parameter_2_ru":"Надежность: MTBF ≥ 8 млн циклов","parameters_ru":"{\"Материал\":\"Нержавеющая сталь SUS304, толщина 1.5 мм\",\"Ширина прохода\":\"до 110 см (удобно для крупногабаритных вещей)\",\"Привод/Механизм\":\"Бесколлекторный двигатель DC + спиральный механизм с защитой от столкновений\",\"Срок службы\":\"MTBF ≥ 8 млн циклов, плавное ускорение и торможение\",\"Безопасность\":\"Тройная защита от защемления (механическая, токовая, электронная); ИК-датчики контроля\",\"Скорость открытия\":\"≥ 0.8 с, 10 уровней регулировки скорости\",\"Аварийный режим\":\"Интеграция с пожарной сигнализацией (автооткрытие) и разблокировка при потере питания\",\"Интерактивность\":\"Светодиодная подсветка прохода и атмосферная подсветка, голосовые сообщения\",\"Стандарт исполнения\":\"Прецизионная лазерная резка, защита IP\",\"Уровень шума\":\"≤ 65 дБ\",\"Габаритные размеры\":\"1400 * 180 * 1000 мм\"}","detail_html_ru":"<h4>Особенности и преимущества</h4><ul><li>Корпус из нержавеющей стали SUS304: Бесшовная лазерная сварка и высокая устойчивость к коррозии даже на открытом воздухе.</li><li>Высокая эффективность: Отклик системы менее 0.8 секунды для быстрой проходимости в часы пик.</li><li>Комплексная защита: Алгоритмы автоматической остановки при столкновении и интеграция с системами пожарной безопасности.</li><li>Защита от несанкционированного прохода: Инфракрасная матрица распознает попытки «прохода паровозиком» с интервалом от 100 мм.</li><li>Визуальная индикация: Трехцветные светодиоды на верхней крышке интуитивно подсказывают статус прохода (зеленый/красный/желтый).</li><li>Низкие эксплуатационные расходы: Благодаря высокому MTBF и системе самодиагностики.</li></ul>","id":40,"raw_json":"$35","created_at":"2026-05-07 15:56:24","updated_at":"2026-05-07 15:56:24"},"locale":"en","dict":"$e"}]}]]

background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Speed Range"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"1m/s - 150m/s (Radial)"}]]}],["$","tr","8",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Range Accuracy"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"≤7.5m"}]]}],["$","tr","9",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Azimuth Accuracy"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"≤0.3°"}]]}],["$","tr","10",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Pitch Accuracy"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"≤0.5°"}]]}],["$","tr","11",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Data Rate"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"2s"}]]}],["$","tr","12",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Simultaneous Targets"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"≥500 tracks"}]]}]]}]]}]}]]}]}],["$","section",null,{"id":"inquiry","className":"detail-section alt","style":{"padding":"80px 0","background":"#f8fafc"},"children":["$","div",null,{"className":"container","style":{"maxWidth":"1200px"},"children":["$","$a",null,{"fallback":["$","div",null,{"style":{"minHeight":"400px","background":"#f8fafc"}}],"children":["$","$L31",null,{"dict":"$e"}]}]}]}]]}]}]}],["$","div",null,{"className":"mobile_only","children":["$","$L32",null,{"product":{"product_name":"低空探测雷达2","product_name_en":"Low-Altitude Detection Radar (Ku-Band)","summary":"采用先进的基于DBF的一维同时多波束体制，具备探测多旋翼无人机、固定翼无人机、穿越机、巡飞弹、蜂群等多种飞行器的能力，实时获取目标的位置(距离、方位、俯仰、经度、纬度、高度等)、运动态势(速度)、回波强度、RCS、目标类型等多维信息。该雷达可以精确探测目标的空间位置，可与干扰、导航诱骗等反制设备级联。 图1低空探测雷达","summary_en":"Utilizing an advanced DBF-based one-dimensional simultaneous multi-beam architecture, this radar is capable of detecting a wide variety of aircraft including multi-rotor drones, fixed-wing drones, FPVs, loitering munitions, and swarms. It captures multi-dimensional real-time data such as target position (range, azimuth, pitch, longitude, latitude, altitude), motion status (speed), echo intensity, RCS, and target type. The radar provides precise spatial positioning and can be cascaded with neutralization equipment like jammers and navigation spoofers.","key_application":"应用领域：采用固态有源收发系统设计和数字信号处理技术，可靠性、安全性、保障性、测试性、可操作性、可维修性程度高。；具有全方位、全天候、全天时的目标自动检测和跟踪能力。；支持夜晚、雨、雪、大雾等条件下正常工作。","key_application_en":"Solid-state active T/R system for high reliability and security; 360° all-weather automatic target detection and tracking; robust performance in rain, snow, and dense fog; weak target recognition based on motion analysis.","key_parameter_1":"工作频段: Ku (15.9-16.2GHz)","key_parameter_1_en":"Frequency Range: Ku (15.9-16.2GHz)","key_parameter_2":"体制: DBF","key_parameter_2_en":"Architecture: DBF (Digital Beamforming)","parameters":{"体制":"DBF","波束扫描方式":"俯仰同时多波束 方位机械扫描","工作频段":"Ku (15.9-16.2GHz)","探测威力":"≥5km (RCS=0.01㎡)","距离盲区":"≤150m","方位覆盖范围":"360°","俯仰覆盖范围":"≥60°","测速范围 (径向)":"1m/s ~ 150m/s","距离测量精度":"≤7.5m","方位测量精度":"≤0.3°","俯仰测量精度":"≤0.5°","数据率":"2s","同时探测的目标数量":"≥500批"},"parameters_en":"{\"Technology\":\"DBF (Digital Beamforming)\",\"Scanning Mode\":\"Simultaneous multi-beam pitch, Mechanical azimuth\",\"Frequency Band\":\"Ku (15.9-16.2GHz)\",\"Detection Range\":\"≥5km (RCS=0.01㎡)\",\"Blind Zone\":\"≤150m\",\"Azimuth Coverage\":\"360°\",\"Pitch Coverage\":\"≥60°\",\"Speed Range\":\"1m/s - 150m/s (Radial)\",\"Range Accuracy\":\"≤7.5m\",\"Azimuth Accuracy\":\"≤0.3°\",\"Pitch Accuracy\":\"≤0.5°\",\"Data Rate\":\"2s\",\"Simultaneous Targets\":\"≥500 tracks\"}","detail_html":"<h4>功能特点</h4><ul><li>采用固态有源收发系统设计和数字信号处理技术，可靠性、安全性、保障性、测试性、可操作性、可维修性程度高。</li><li>具有全方位、全天候、全天时的目标自动检测和跟踪能力。</li><li>支持夜晚、雨、雪、大雾等条件下正常工作。</li><li>采用基于目标运动特征的弱小目标检测及识别技术，能够实现对目标无人机的有效预警、精确测量及数据上报。</li><li>具有多批次目标的探测和跟踪能力。</li><li>具有方位360°搜索功能，能够进行方位无死角探测。</li><li>具有在线监测、故障诊断与定位能力。</li><li>具备电子地图在线加载和离线下载功能。</li><li>基本参数</li><li>波束扫描方式</li><li>俯仰同时多波束 方位机械扫描</li><li>工作频段</li><li>Ku (15.9-16.2GHz)</li><li>探测威力</li><li>≥5km (RCS=0.01㎡)</li><li>距离盲区</li><li>≤150m</li><li>方位覆盖范围</li><li>360°</li><li>俯仰覆盖范围</li><li>≥60°</li><li>测速范围 (径向)</li><li>1m/s ~ 150m/s</li><li>距离测量精度</li><li>≤7.5m</li><li>方位测量精度</li><li>≤0.3°</li><li>俯仰测量精度</li><li>≤0.5°</li><li>同时探测的目标数量</li><li>≥500批</li></ul>","detail_html_en":"<h4>Key Features</h4><ul><li>Ku-band active phased array radar for low-altitude, slow, and small (LSS) target detection.</li><li>Maximum detection range up to 8km for small drone targets (RCS 0.01m²).</li><li>360° continuous azimuth scanning with fast update rate.</li><li>Simultaneous multi-target detection and tracking capability.</li><li>Advanced clutter suppression and anti-interference processing algorithms.</li><li>All-weather operation, unaffected by rain, fog, or darkness.</li><li>Standard interfaces for integration with electro-optical, RF detection, and C-UAS systems.</li></ul>","main_image":"/products/anti-drone/Low-Altitude-Detection-Radar.png","handle":"low-altitude-detection-radar-ku-band","category_primary":"anti-drone-cuas","category_secondary":"Detection & Tracking (探测与跟踪)","category_tertiary":"Low-Altitude Detection Radars (低空探测雷达)","product_name_ru":"РЛС обнаружения маловысотных целей (Ku-диапазон)","summary_ru":"Радиолокационная станция использует передовую архитектуру одномерного цифрового формирования луча (DBF), обеспечивая обнаружение мультироторных и фиксированных БПЛА, FPV-дронов, барражирующих боеприпасов и роев. РЛС в реальном времени получает координаты (дальность, азимут, угол места), параметры движения (скорость), интенсивность эха и ЭПР (RCS) целей. Обеспечивает точное целеуказание для средств подавления и навигационного спуфинга.","key_application_ru":"Твердотельная активная приемопередающая система; круговое автоматическое обнаружение и сопровождение 24/7; стабильная работа в дождь, снег и туман; распознавание сверхмалых целей.","key_parameter_1_ru":"Рабочий диапазон: Ku (15.9–16.2 ГГц)","key_parameter_2_ru":"Дальность обнаружения: ≥ 5 км","parameters_ru":"{\"Технология\":\"DBF (Цифровое формирование луча)\",\"Режим сканирования\":\"Многолучевое по углу места, механическое по азимуту\",\"Рабочий диапазон\":\"Ku (15.9–16.2 ГГц)\",\"Дальность обнаружения\":\"≥ 5 км (при ЭПР=0.01 кв.м)\",\"Мертвая зона\":\"≤ 150 м\",\"Покрытие по азимуту\":\"360°\",\"Покрытие по углу места\":\"≥ 60°\",\"Диапазон скоростей\":\"1–150 м/с (радиальная)\",\"Точность по дальности\":\"≤ 7.5 м\",\"Точность по азимуту\":\"≤ 0.3°\",\"Точность по углу места\":\"≤ 0.5°\",\"Темп обновления данных\":\"2 с\",\"Количество целей\":\"≥ 500 трасс одновременно\"}","detail_html_ru":"<h4>Особенности и преимущества</h4><ul><li>Высокая надежность: Твердотельная архитектура и цифровая обработка сигналов обеспечивают длительный срок службы и удобство обслуживания.</li><li>Всепогодный мониторинг: Алгоритмы подавления отражений от подстилающей поверхности и помех позволяют работать в условиях осадков и тумана.</li><li>Интеллектуальный анализ: Распознавание целей на основе характеристик движения для минимизации ложных тревог от птиц.</li><li>Бесшовная интеграция: Стандартные интерфейсы для каскадного подключения оптико-электронных систем и джаммеров.</li><li>Автоматизация: Онлайн-загрузка электронных карт и автоматическое логирование всех траекторий целей.</li></ul>","id":22,"raw_json":"$33","created_at":"2026-05-07 15:56:24","updated_at":"2026-05-07 15:56:24"},"locale":"en","dict":"$e"}]}]]

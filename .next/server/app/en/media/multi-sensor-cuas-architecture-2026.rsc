ize":"5.2rem","fontWeight":900,"color":"#fff","marginBottom":"15px","lineHeight":1.1},"children":"Insights & Global Feed"}],["$","p",null,{"style":{"fontSize":"2rem","color":"#fff","lineHeight":1.5,"opacity":0.95},"children":"Stay updated with the latest technological breakthroughs and industry analysis from N-TET."}]]}]}]]}],["$","article",null,{"style":{"padding":"80px 0"},"children":["$","div",null,{"className":"container","style":{"maxWidth":"1200px"},"children":[["$","div",null,{"style":{"textAlign":"center","marginBottom":"60px"},"children":[["$","h1",null,{"style":{"fontSize":"4.8rem","fontWeight":900,"color":"#333","lineHeight":"1.2","marginBottom":"30px"},"children":"Why Modern C-UAS Systems Need Three Sensor Layers, Not One"}],["$","div",null,{"style":{"fontSize":"1.8rem","color":"#666","fontWeight":500},"children":"Apr 14, 2026"}]]}],["$","div",null,{"style":{"marginBottom":"50px","position":"relative","height":"500px","width":"100%","backgroundColor":"#f5f5f5"},"children":["$","$L2e",null,{"src":"/cases/机场低空安防应用/main.png","alt":"Why Modern C-UAS Systems Need Three Sensor Layers, Not One","fill":true,"style":{"objectFit":"cover","borderRadius":"8px"},"sizes":"100vw"}]}],["$","div",null,{"className":"news-rich-content","style":{"fontSize":"1.8rem","lineHeight":"1.8","color":"#444"},"children":["$","$L2f",null,{"className":"rich-content","html":"$30"}]}]]}]}],["$","section",null,{"style":{"padding":"100px 0","backgroundColor":"#f9f9f9","borderTop":"1px solid #eee"},"children":["$","div",null,{"className":"container","style":{"maxWidth":"1200px"},"children":["$","$L31",null,{"dict":"$e"}]}]}]]}]}],["$","div",null,{"className":"mobile_only","children":["$","$L32",null,{"news":{"id":"multi-sensor-cuas-architecture-2026","category":"product","title":"Why Modern C-UAS Systems Need Three Sensor Layers, Not One","date":"Apr 14, 2026","image":"/cases/机场低空安防应用/main.png","content":"$33","title_ru":"Почему современным системам C-UAS нужны три уровня датчиков, а не один","content_ru":"<p>Ни одна технология не может в одиночку решить проблему обнаружения дронов. Радиочастотные пеленгаторы, радары и оптико-электронные системы имеют свои ограничения, которые компенсируются только при совместном использовании.</p><h3>Трехуровневая архитектура</h3><p>Современные стеки объединяют радары для объемного поиска, РЧ-датчики для идентификации протоколов и EO/IR камеры для визуального подтверждения цели. Интеграция этих данных позволяет создать юридически обоснованную цепочку доказательств при принятии мер противодействия.</p>"},"locale":"en","dict":"$e"}]}]]

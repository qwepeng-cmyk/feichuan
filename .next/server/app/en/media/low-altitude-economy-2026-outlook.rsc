},"children":[["$","h1",null,{"style":{"fontSize":"5.2rem","fontWeight":900,"color":"#fff","marginBottom":"15px","lineHeight":1.1},"children":"Insights & Global Feed"}],["$","p",null,{"style":{"fontSize":"2rem","color":"#fff","lineHeight":1.5,"opacity":0.95},"children":"Stay updated with the latest technological breakthroughs and industry analysis from N-TET."}]]}]}]]}],["$","article",null,{"style":{"padding":"80px 0"},"children":["$","div",null,{"className":"container","style":{"maxWidth":"1200px"},"children":[["$","div",null,{"style":{"textAlign":"center","marginBottom":"60px"},"children":[["$","h1",null,{"style":{"fontSize":"4.8rem","fontWeight":900,"color":"#333","lineHeight":"1.2","marginBottom":"30px"},"children":"China's Low-Altitude Economy: 2026 Outlook on a Two-Trillion-RMB Trajectory"}],["$","div",null,{"style":{"fontSize":"1.8rem","color":"#666","fontWeight":500},"children":"Apr 28, 2026"}]]}],["$","div",null,{"style":{"marginBottom":"50px","position":"relative","height":"500px","width":"100%","backgroundColor":"#f5f5f5"},"children":["$","$L2e",null,{"src":"https://images.unsplash.com/photo-1480714378408-67cf0d13bc1b?auto=format&fit=crop&w=1400&q=85","alt":"China's Low-Altitude Economy: 2026 Outlook on a Two-Trillion-RMB Trajectory","fill":true,"style":{"objectFit":"cover","borderRadius":"8px"},"sizes":"100vw"}]}],["$","div",null,{"className":"news-rich-content","style":{"fontSize":"1.8rem","lineHeight":"1.8","color":"#444"},"children":["$","$L2f",null,{"className":"rich-content","html":"$30"}]}]]}]}],["$","section",null,{"style":{"padding":"100px 0","backgroundColor":"#f9f9f9","borderTop":"1px solid #eee"},"children":["$","div",null,{"className":"container","style":{"maxWidth":"1200px"},"children":["$","$L31",null,{"dict":"$e"}]}]}]]}]}],["$","div",null,{"className":"mobile_only","children":["$","$L32",null,{"news":{"id":"low-altitude-economy-2026-outlook","category":"industry","title":"China's Low-Altitude Economy: 2026 Outlook on a Two-Trillion-RMB Trajectory","date":"Apr 28, 2026","image":"https://images.unsplash.com/photo-1480714378408-67cf0d13bc1b?auto=format&fit=crop&w=1400&q=85","content":"$33","title_ru":"Экономика малых высот Китая: Прогноз на 2026 год с оборотом в 2 трлн юаней","content_ru":"<p>Экономика малых высот охватывает логистику, аэрофотосъемку и экстренные службы на высотах до 1000 метров. В Китае этот сектор стал стратегическим направлением, с прогнозируемым объемом в 2 триллиона юаней к 2030 году.</p><h3>Факторы роста</h3><p>Развитие инфраструктуры «умных городов», успех электрических аппаратов вертикального взлета (eVTOL) и нормализация использования БПЛА в промышленности формируют устойчивую траекторию роста отрасли.</p>"},"locale":"en","dict":"$e"}]}]]

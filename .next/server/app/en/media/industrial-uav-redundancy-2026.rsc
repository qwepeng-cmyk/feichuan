div",null,{"className":"container","style":{"position":"relative","zIndex":1},"children":["$","div",null,{"style":{"maxWidth":"800px"},"children":[["$","h1",null,{"style":{"fontSize":"5.2rem","fontWeight":900,"color":"#fff","marginBottom":"15px","lineHeight":1.1},"children":"Insights & Global Feed"}],["$","p",null,{"style":{"fontSize":"2rem","color":"#fff","lineHeight":1.5,"opacity":0.95},"children":"Stay updated with the latest technological breakthroughs and industry analysis from N-TET."}]]}]}]]}],["$","article",null,{"style":{"padding":"80px 0"},"children":["$","div",null,{"className":"container","style":{"maxWidth":"1200px"},"children":[["$","div",null,{"style":{"textAlign":"center","marginBottom":"60px"},"children":[["$","h1",null,{"style":{"fontSize":"4.8rem","fontWeight":900,"color":"#333","lineHeight":"1.2","marginBottom":"30px"},"children":"Dual-Redundant Flight Control: How Industrial UAVs Achieve Mission-Grade Reliability"}],["$","div",null,{"style":{"fontSize":"1.8rem","color":"#666","fontWeight":500},"children":"May 06, 2026"}]]}],["$","div",null,{"style":{"marginBottom":"50px","position":"relative","height":"500px","width":"100%","backgroundColor":"#f5f5f5"},"children":["$","$L2e",null,{"src":"/case_banner/4.png","alt":"Dual-Redundant Flight Control: How Industrial UAVs Achieve Mission-Grade Reliability","fill":true,"style":{"objectFit":"cover","borderRadius":"8px"},"sizes":"100vw"}]}],["$","div",null,{"className":"news-rich-content","style":{"fontSize":"1.8rem","lineHeight":"1.8","color":"#444"},"children":["$","$L2f",null,{"className":"rich-content","html":"$30"}]}]]}]}],["$","section",null,{"style":{"padding":"100px 0","backgroundColor":"#f9f9f9","borderTop":"1px solid #eee"},"children":["$","div",null,{"className":"container","style":{"maxWidth":"1200px"},"children":["$","$L31",null,{"dict":"$e"}]}]}]]}]}],["$","div",null,{"className":"mobile_only","children":["$","$L32",null,{"news":{"id":"industrial-uav-redundancy-2026","category":"product","title":"Dual-Redundant Flight Control: How Industrial UAVs Achieve Mission-Grade Reliability","date":"May 06, 2026","image":"/case_banner/4.png","content":"$33","title_ru":"Двойное резервирование управления полетом: Как промышленные БПЛА достигают надежности миссионного уровня","content_ru":"<p>Промышленные беспилотники стали стандартом для инспекции электросетей и мониторинга трубопроводов. В таких задачах надежность становится критическим фактором. Архитектуры с двойным резервированием управления полетом теперь являются базовым требованием для серьезных заказчиков.</p><h3>Технический контекст</h3><p>Основой систем миссионного уровня является дублирование датчиков и вычислений: два инерциальных модуля (IMU), два GNSS-приемника и два полетных компьютера, работающих параллельно. Переключение на резервный канал происходит за 50 миллисекунд.</p>"},"locale":"en","dict":"$e"}]}]]

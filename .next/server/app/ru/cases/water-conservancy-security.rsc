"padding":"80px 0","background":"#f8fafc"},"children":["$","div",null,{"className":"container","children":["$","div",null,{"style":{"maxWidth":"1000px","margin":"0 auto","background":"#fff","padding":"60px","borderRadius":"12px","boxShadow":"0 4px 20px rgba(0,0,0,0.05)"},"children":["$","$L2e",null,{"className":"rich-content","html":""}]}]}]}]]}]}]}],["$","div",null,{"className":"mobile_only","children":["$","$L2f",null,{"caseData":{"title":"水利设施低空安保","title_en":"Water Conservancy Facility Low-Altitude Security","description":"水利设施低空安保\n对于水力发电站（含水坝、厂房及输电枢纽）等国家关键能源设施面临的低空安全威胁，本项目构建一套专业的无人机防御体系。本系统采用“无线电侦测+无线电干扰”相结合的主动防御技术，具备精准识别与高效拦截入侵无人机的能力。\n针对水电站特有的高湿度、多粉尘复杂环境，设备进行了专项适应性设计，确保全天候稳定工作。设备支持分级防护策略，可根据大坝核心区、库区等不同区域的风险等级定制防御手段，形成“侦测-识别-反制”的闭环管理。\n该方案已在国内多个大型水电站成功落地应用，实战效果显著，构建起了全天候、全自动的低空安全防护网。为水电站的安全提供坚实可靠的低空安全保障。\n图26水力发电站低空安保","description_en":"$30","devices":["固定式无线电侦测设备","固定式反无人机无线电主动防御设备"],"devices_en":"[\"Stationary RF Detection System\",\"Stationary Active RF Defense System (Spoofing)\"]","main_image":"/cases/水利设施低空安保/main.webp","case_images":"[\"/cases/水利设施低空安保/水力发电站低空安保.webp\"]","recommendedProductHandles":["stationary-rf-detection-system","stationary-active-rf-defense-system"],"handle":"water-conservancy-security","title_ru":"Защита объектов водного хозяйства от БПЛА","description_ru":"Безопасность гидротехнических сооружений\nДля защиты ГЭС, дамб и узлов электропередач была внедрена профессиональная система обороны от БПЛА, использующая сочетание радиообнаружения и активного подавления. Оборудование адаптировано к высокой влажности и запыленности, обеспечивая стабильную работу 24/7.\nСистема поддерживает эшелонированную защиту, позволяя настраивать меры противодействия для различных зон (тело плотины, водохранилище). Данное решение успешно внедрено на нескольких крупнейших ГЭС Китая, создав надежную автоматизированную сеть защиты критически важной энергетической инфраструктуры.","devices_ru":"[\"Стационарная система радиочастотного обнаружения\",\"Стационарная активная система защиты (навигационная имитация)\"]","region_ru":"Азия","country_ru":"Китай","region_en":"Asia","country_en":"China","solution_category_id":"02_InfrastructureProtection","id":6,"parameters_en":"[]","parameters_ru":"[]","recommended_product_handles":"[\"stationary-rf-detection-system\",\"stationary-active-rf-defense-system\"]","raw_json":"$31","created_at":"2026-05-07 15:56:24","updated_at":"2026-05-07 15:56:24"},"recommendedProducts":[],"locale":"ru","dict":"$e"}]}]]

m"},"children":"Накопленная доза"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"0.00 мкЗв ～ 9999 Зв"}]]}],["$","tr","7",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Энергетический диапазон X-γ"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"25 кэВ ～ 3.0 МэВ"}]]}],["$","tr","8",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Энергетическая зависимость"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"не более ±30% (относительно 137Cs)"}]]}],["$","tr","9",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Пороги срабатывания"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Настраиваются во всем диапазоне измерений"}]]}],["$","tr","10",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Единицы измерения"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Мощность дозы: мкЗв/ч, мЗв/ч (автовыбор); Накопленная доза: мкЗв, мЗв, Зв; Скорость счета: имп/с"}]]}],["$","tr","11",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Питание"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Встроенная литиевая батарея 3.7В 1100мАч, зарядка USB Type-C"}]]}],["$","tr","12",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Размеры и вес"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"118 × 28 × 16 мм, вес 60 г"}]]}],["$","tr","13",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Порог тревоги по мощности дозы"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Настраивается во всем диапазоне измерений"}]]}],["$","tr","14",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Порог тревоги по накопленной дозе"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Настраивается во всем диапазоне измерений"}]]}]]}]]}]}]]}]}],["$","section",null,{"id":"inquiry","className":"detail-section alt","style":{"padding":"80px 0","background":"#f8fafc"},"children":["$","div",null,{"className":"container","style":{"maxWidth":"1200px"},"children":["$","$a",null,{"fallback":["$","div",null,{"style":{"minHeight":"400px","background":"#f8fafc"}}],"children":["$","$L31",null,{"dict":"$e"}]}]}]}]]}]}]}],["$","div",null,{"className":"mobile_only","children":["$","$L32",null,{"product":{"product_name":"X、γ辐射剂量报警仪FC902","product_name_en":"X-γ Radiation Dose Alarm FC902","summary":"FC902系列是一款小型笔式的高灵敏度的Xγ辐射剂量报警仪，本仪器采用高速的低功耗嵌入式微处理器作为数据处理单元，探测器模块采用了高灵敏度的闪烁体探测器。仪器具有响应快，测量范围宽，应用范围广的特点，可监测X、γ射线，是一款通用型便携式辐射测量仪。","summary_en":"The FC902 series is a compact pen-type high-sensitivity X-γ radiation dose alarm. The instrument uses a high-speed, low-power embedded microprocessor as the data processing unit, and the detector module uses a high-sensitivity scintillator detector. The instrument features fast response, wide measurement range, and broad application scope. It can monitor X and γ rays, and is a universal portable radiation measurement instrument.","key_application":"应用领域：放射性工作人员个人剂量监测；核设施周边环境监测；海关、口岸放射性物品监测；疾控中心、环保部门辐射安全巡检。","key_application_en":"Personal dose monitoring for radiological workers; environmental monitoring near nuclear facilities; radioactive material screening at customs and borders; radiation safety inspections for health and environmental agencies.","key_parameter_1":"探测器类型: 碘化铯CsI + SiPM固态光电倍增器","key_parameter_1_en":"Detector Type: CsI + SiPM Solid-State Photomultiplier","key_parameter_2":"剂量率范围: 0.01 μSv/h - 1 mSv/h","key_parameter_2_en":"Dose Rate Range: 0.01 μSv/h - 1 mSv/h","parameters":{"探测器类型":"碘化铯CsI+ SiPM 固态光电倍增器","伽玛灵敏度":"约70cps / (μSv/h)（相对于137Cs）","相对基本误差":"不超过±15%（在10μSv/h 时，137Cs）","剂量率范围":"0.01 μSv/h - 1 mSv/h","防护报警响应时间":"≤1 秒","数据导出功能":"USB（蓝牙版支持USB+蓝牙小程序）","累积剂量":"0.00μSv ～9999Sv","X-γ能量范围":"25keV～3.0MeV","能量响应误差":"不超过±30%（相对于137Cs）","剂量率报警阈值":"全量程内可调","累计剂量报警阈值":"全量程内可调","显示单位":"剂量率：μSv/h、mSv/h 自动切换；μR/h、mR/h 自动切换；累积剂量：μSv、mSv、Sv 自动切换；计数率:cps","供电方式":"内置3.7V，1100mA 锂电池，USB TYPE-C 充电接口","重量尺寸":"长x宽x厚(118×28×16) mm，含背夹厚度20mm；重量：60g","使用环境":"-15℃～＋50℃，相对湿度≤95%（40±2)℃"},"parameters_en":"{\"Detector Type\":\"CsI + SiPM Solid-State Photomultiplier\",\"Gamma Sensitivity\":\"Approx. 70cps / (μSv/h) (relative to 137Cs)\",\"Relative Basic Error\":\"Not exceeding ±15% (at 10μSv/h, 137Cs)\",\"Dose Rate Range\":\"0.01 μSv/h - 1 mSv/h\",\"Protection Alarm Response Time\":\"≤1 second\",\"Data Export\":\"USB (Bluetooth version supports USB + Bluetooth mini-program)\",\"Accumulated Dose\":\"0.00μSv - 9999Sv\",\"X-γ Energy Range\":\"25keV - 3.0MeV\",\"Energy Response Error\":\"Not exceeding ±30% (relative to 137Cs)\",\"Dose Rate Alarm Threshold\":\"Adjustable within full range\",\"Accumulated Dose Alarm Threshold\":\"Adjustable within full range\",\"Display Units\":\"Dose rate: μSv/h, mSv/h auto-switching; μR/h, mR/h auto-switching; Accumulated dose: μSv, mSv, Sv auto-switching; Count rate: cps\",\"Power Supply\":\"Built-in 3.7V, 1100mA lithium battery, USB TYPE-C charging interface\",\"Dimensions & Weight\":\"L×W×H (118×28×16) mm, 20mm with back clip; Weight: 60g\",\"Operating Environment\":\"-15℃ to +50℃, relative humidity ≤95% (40±2)℃\"}","detail_html":"<h4>功能特点</h4><ul><li>采用CsI碘化铯闪烁体+SiPM固态光电倍增器。</li><li>全彩TFT液晶LCD显示器，支持中英文操作界面。</li><li>小巧笔式设计，自带背夹，可装挂绳，方便携带。</li><li>可同时进行剂量率和累积剂量的测量和显示。</li><li>自动切换量程，自动保存累积剂量；断电可永久保存累积剂量和累计时长。</li><li>可自定义剂量率、累计剂量报警阈值。</li><li>支持声音、振动、声音+振动、静音四种报警方式。</li><li>内置1100mA大容量可充电锂电池，支持实时电压指示。</li><li>具备自动故障检测及保护功能，抗电磁干扰。</li><li>可连续保存98300条实时记录和32760条报警记录。</li><li>数值可通过USB导出（选配专用软件）。</li><li>可选配蓝牙通信和手机小程序。</li></ul><h4>配置清单</h4><ul><li>仪器、挂绳、USB充电线、保护包、说明书、保修卡、合格证</li></ul>","detail_html_en":"$33","main_image":"/products/security/FC902-Personal-Radiation-Dose-Alarm.png","handle":"fc902-personal-radiation-dose-alarm","category_primary":"security-screening","category_secondary":"Nuclear & Radiation Detectors (核生化检测设备 - 辐射/剂量报警仪)","category_tertiary":"Radiation Dose Alarms (辐射剂量报警仪)","product_name_ru":"Индивидуальный сигнализатор дозы рентгеновского и гамма-излучения FC902","summary_ru":"Серия FC902 — это компактный персональный дозиметр ручного типа с высокой чувствительностью. В качестве вычислительного блока используется высокоскоростной встроенный микропроцессор с низким энергопотреблением, а в качестве детектора — высокочувствительный сцинтиллятор. Прибор отличается быстрым откликом, широким диапазоном измерений и областей применения. Предназначен для мониторинга рентгеновского и гамма-излучения.","key_application_ru":"Индивидуальный дозиметрический контроль персонала; мониторинг окружающей среды вблизи ядерных объектов; радиологический контроль на таможне и границе; инспекции радиационной безопасности.","key_parameter_1_ru":"Тип детектора: Сцинтиллятор CsI + SiPM","key_parameter_2_ru":"Мощность дозы: 0.01 мкЗв/ч - 1 мЗв/ч","parameters_ru":"$34","detail_html_ru":"<h4>Особенности и преимущества</h4><ul><li>Инновационный детектор: Сочетание сцинтиллятора CsI и SiPM для максимальной чувствительности.</li><li>Цветной ЖК-дисплей: Четкое отображение данных с поддержкой русского/английского языков.</li><li>Компактность: Дизайн в виде ручки с клипсой для ношения на кармане.</li><li>Двойной мониторинг: Одновременное отображение текущей мощности дозы и накопленной дозы.</li><li>Энергонезависимая память: Данные сохраняются даже при полной разрядке аккумулятора.</li><li>Разнообразные оповещения: Звук, вибрация, комбинированный режим или беззвучный режим.</li><li>Длительная работа: До 98 000 записей журнала и мощный аккумулятор 1100 мАч.</li></ul>","id":42,"raw_json":"$35","created_at":"2026-05-07 15:56:24","updated_at":"2026-05-07 15:56:24"},"locale":"ru","dict":"$e"}]}]]

  "parameters_en": {
    "Frequency Range": "300MHz-6000MHz",
    "Detection Mode": "Passive detection, Spectrum analysis, Protocol decoding",
    "Detection Angle": "360° Horizontal",
    "Detection Radius": "5km",
    "Direction Accuracy": "≤3° (RMS)",
    "Identification Time": "≤3s",
    "Screen Size": "13.3 inch",

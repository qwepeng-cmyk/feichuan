le":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Работа в сети"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"12 рабочих частот; поддержка установки в ряд (дистанция от 35 мм)"}]]}],["$","tr","7",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Вес устройства"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"около 45 кг"}]]}],["$","tr","8",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Энергопотребление"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"< 35 Вт"}]]}],["$","tr","9",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Размеры прохода"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"2000(В) x 710(Ш) x 400(Г) мм"}]]}],["$","tr","10",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Настройка частоты"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Бесступенчатая регулировка в зависимости от условий установки"}]]}]]}]]}]}]]}]}],["$","section",null,{"id":"inquiry","className":"detail-section alt","style":{"padding":"80px 0","background":"#f8fafc"},"children":["$","div",null,{"className":"container","style":{"maxWidth":"1200px"},"children":["$","$a",null,{"fallback":["$","div",null,{"style":{"minHeight":"400px","background":"#f8fafc"}}],"children":["$","$L31",null,{"dict":"$e"}]}]}]}]]}]}]}],["$","div",null,{"className":"mobile_only","children":["$","$L32",null,{"product":{"product_name":"FC-C (豪华型) 通过式金属检测门","product_name_en":"Walk-Through Metal Detector FC-C (Deluxe)","summary":"FC-C 金属探测门是一种检测人员有无携带金属物品的探测装置，又称金属探测安检门。它广泛应用于监狱、法院、博物馆、图书馆、医院、学校、电子厂、港口、高铁站、演唱会及大型会议等人流较大的公共场所。该设备专门用于检查人体隐藏的危险金属物品，如枪支、管制刀具等，确保高敏感区域的公共安全。","summary_en":"The FC-C metal detection gate is a specialized security device designed to detect whether personnel are carrying metallic objects. Widely known as a walk-through metal detector, it is extensively deployed in prisons, courts, museums, libraries, hospitals, schools, electronic factories, ports, and high-speed rail stations. It is also an essential screening tool for concert venues and large conferences, effectively identifying hidden dangerous items such as firearms and controlled knives to ensure the highest level of public safety in high-traffic environments.","key_application":"应用领域：FC-C(豪华型)通过式金属探测门；广泛应用于人流较大的公共场所及高敏感区域，用于检查人身体上隐藏的危险金属物品。","key_application_en":"High-precision security screening for airports, stations, and government buildings; 12-zone independent alarm display; adjustable 1000-level sensitivity; robust anti-interference and vibration resistance.","key_parameter_1":"探测区域: 12个互相重叠的网状探测区","key_parameter_1_en":"Detection Zones: 12 overlapping mesh zones","key_parameter_2":"整机尺寸: (mm) 2200(高) x 840(宽) x 475(深)","key_parameter_2_en":"Overall Dimensions: 2200(H) x 840(W) x 475(D) mm","parameters":{"探测防区":"12个独立防区，单区或多区同时显示物品位置","灵敏度等级":"0-1000级可调，最高可探至一枚回形针大小","抗干扰能力":"采用 1000 级 DSP 数字过滤，具有超强磁电兼容性","材质工艺":"ABS 材质门体，配置铝合金支柱与防水防火板","统计功能":"微型计算机控制，自动统计通过人数与报警次数","安全性":"符合弱磁场技术标准，对起搏器、孕妇、磁性介质无害","并网能力":"12个工作频点，支持多台并排使用（间距仅35mm）","整机重量":"约 45kg","整机功耗":"<35W","工作频率":"可根据安装环境自行无级调节","通道尺寸":"(mm) 2000(高) x 710(宽) x 400(深)"},"parameters_en":"{\"Detection Zones\":\"12 independent overlapping zones with multi-target display\",\"Sensitivity Range\":\"0-1000 adjustable levels; detects items as small as a paperclip\",\"Anti-interference\":\"1000-level DSP digital filtering for superior electromagnetic compatibility\",\"Construction\":\"ABS housing with aluminum alloy supports and waterproof/flame-retardant panels\",\"Intelligence\":\"Microcomputer-controlled automatic traffic and alarm counting\",\"Health Safety\":\"Weak magnetic field technology; safe for pacemakers and pregnant women\",\"Tactical Deployment\":\"12 frequencies; supports side-by-side use (35mm interval)\",\"Weight\":\"Approx. 45kg\",\"Power Consumption\":\"<35W\",\"Frequency Adjustment\":\"Infinitely adjustable based on installation environment\",\"Passage Dimensions\":\"2000(H) x 710(W) x 400(D) mm\"}","detail_html":"$33","detail_html_en":"$34","main_image":"/products/security/FC-C-(Deluxe)-Walk-Through-Metal-Detector.png","handle":"fc-c-deluxe-walk-through-metal-detector","category_primary":"security-screening","category_secondary":"Safety Inspection Gates (安检门/探测门)","category_tertiary":"Walk-Through Metal Detectors (通过式金属探测门)","product_name_ru":"Арочный металлодетектор FC-C (Делюкс)","summary_ru":"Металлодетектор FC-C — это стационарное устройство для обнаружения металлических предметов на теле человека. Широко применяется в тюрьмах, судах, музеях, школах, аэропортах и на крупных мероприятиях. Устройство предназначено для выявления скрытого оружия, ножей и других опасных металлических предметов, обеспечивая общественную безопасность в местах с высоким пассажиропотоком.","key_application_ru":"Высокоточный досмотр для госучреждений и транспорта; 12 независимых зон обнаружения; 1000 уровней чувствительности; защита от помех.","key_parameter_1_ru":"Зоны обнаружения: 12 перекрывающихся зон","key_parameter_2_ru":"Габаритные размеры: 2200 x 840 x 475 мм","parameters_ru":"{\"Зоны обнаружения\": \"12 независимых взаимоперекрывающихся зон\", \"Уровни чувствительности\": \"0-1000 регулируемых уровней; обнаруживает объекты размером со скрепку\", \"Помехоустойчивость\": \"Цифровая фильтрация DSP (1000 уровней) для отличной электромагнитной совместимости\", \"Материалы\": \"Корпус из ABS-пластика с алюминиевыми стойками, огнестойкие и водонепроницаемые панели\", \"Функции статистики\": \"Микропроцессорный контроль, автоматический подсчет проходов и тревог\", \"Безопасность\": \"Слабое магнитное поле; безопасно для кардиостимуляторов, беременных женщин и магнитных носителей\", \"Работа в сети\": \"12 рабочих частот; поддержка установки в ряд (дистанция от 35 мм)\", \"Вес устройства\": \"около 45 кг\", \"Энергопотребление\": \"< 35 Вт\", \"Размеры прохода\": \"2000(В) x 710(Ш) x 400(Г) мм\", \"Настройка частоты\": \"Бесступенчатая регулировка в зависимости от условий установки\"}","detail_html_ru":"<h4>Особенности и преимущества</h4><ul><li>Материалы высокого качества: Корпус из ABS с алюминиевым усилением, устойчив к коррозии и царапинам.</li><li>Защита от вибраций: Исключение ложных срабатываний при тряске или внешних ударах.</li><li>Точное позиционирование: 12 зон обнаружения со светодиодной индикацией на боковых стойках для мгновенного определения места нахождения металла.</li><li>Микропроцессорное управление: Цифровая импульсная технология для точного сканирования и стабильной работы.</li><li>Гибкая настройка: Исключение личных вещей (ремни, ключи, монеты) при сохранении высокой чувствительности к оружию.</li><li>Защита паролем: Изменение настроек доступно только авторизованному персоналу (4-значный пароль).</li><li>Модульная конструкция: Простота сборки и быстрое устранение неисправностей.</li></ul>","id":36,"raw_json":"$35","created_at":"2026-05-07 15:56:24","updated_at":"2026-05-07 15:56:24"},"locale":"ru","dict":"$e"}]}]]

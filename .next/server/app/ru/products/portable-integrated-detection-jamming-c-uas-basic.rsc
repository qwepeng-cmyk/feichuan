["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Дальность подавления"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"≥ 2 км (в условиях прямой видимости)"}]]}],["$","tr","7",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Коэффициент подавления"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"≥ 20:1 (цель: Mavic 2)"}]]}],["$","tr","8",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Время работы"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Ожидание ≥ 1.5 ч; Активное подавление ≥ 15 мин"}]]}],["$","tr","9",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Питание"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Сменный литиевый аккумуляторный модуль"}]]}],["$","tr","10",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Температура"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"-20℃ ~ +55℃"}]]}],["$","tr","11",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Форм-фактор"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Дизайн «щит»"}]]}],["$","tr","12",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Сетевой интерфейс"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Подключение к платформе управления C-UAS"}]]}],["$","tr","13",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Управление"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Сенсорный дисплей 10.1 дюйма"}]]}],["$","tr","14",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Мощность"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"480 Вт"}]]}],["$","tr","15",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Класс защиты"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"IP65"}]]}],["$","tr","16",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Вес"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"6.5 кг"}]]}]]}]]}]}]]}]}],["$","section",null,{"id":"inquiry","className":"detail-section alt","style":{"padding":"80px 0","background":"#f8fafc"},"children":["$","div",null,{"className":"container","style":{"maxWidth":"1200px"},"children":["$","$a",null,{"fallback":["$","div",null,{"style":{"minHeight":"400px","background":"#f8fafc"}}],"children":["$","$L31",null,{"dict":"$e"}]}]}]}]]}]}]}],["$","div",null,{"className":"mobile_only","children":["$","$L32",null,{"product":{"product_name":"便携式无人机察打一体设备","product_name_en":"Integrated Detection & Jamming C-UAS","summary":"便携式无人机察打一体设备集侦测、跟踪、定位、反制、联网功能于一体，单设备即可实现无人机管控全流程工作；系统续航充足、重量轻、加固设计，非常适合背负/手持。 设备通过无线电频率扫描无人机频谱特征，解析Drone ID和Remote ID报文，侦测非法入侵的无人机，能够识别无人机与遥控器之间的控制信号、图传信号；并通过电磁压制技术，实现对无人机遥控链路、图传链路和导航信号的干扰阻断，迫使无人机返航或降落。","summary_en":"The Integrated Detection & Jamming C-UAS combines detection, tracking, positioning, neutralization, and networking functions into one unit, enabling a complete drone control workflow. The system features long battery life, lightweight design, and rugged construction, making it ideal for backpack or handheld use. It scans frequencies for spectral signatures and parses Drone ID and Remote ID messages to detect unauthorized drones. By identifying control and video links and applying electromagnetic suppression, it blocks remote control and navigation signals, forcing drones to land or return.","key_application":"应用领域：设备通过无线电频率扫描无人机频谱特征，解析Drone ID和Remote ID报文，侦测非法入侵的无人机，能够识别无人机与遥控器之间的控制信号、图传信号；并通过电磁压制技术，实现对无人机遥控链路、图传链路和导航信号的干扰阻断，迫使无人机返航或降落。；探测与打击一体化设计，高度集成，单台设备即可完成无人机的探测和打击。；探测机型全","key_application_en":"Integrated detection and strike design for high-portability operations; parses Drone ID and Remote ID for precision identification; 2km effective jamming range; supports single-target precision strike among drone swarms.","key_parameter_1":"最大有效干扰距离: ≥2km（通视条件）","key_parameter_1_en":"Max Jamming Distance: ≥2km (Line-of-sight)","key_parameter_2":"重量: 6.5KG","key_parameter_2_en":"Weight: 6.5kg","parameters":{"侦测模式":"能够提供全向探测和定向测向两种模式","支持多种算法":"频谱识别、Drone ID、Remote ID","探测频段":"433M/800M/900M/1.4G/2.4G/5.2G/5.8G","测向精度":"≤30°（定向侦测）≤0.5°（协议解析）","最大探测/测向距离":"≥3km（净空环境下）","反制频段":"800M/900M/1.2G/1.4G/1.6G/2.4G/5.2G/5.8G","最大有效干扰距离":"≥2km（通视条件）","干通比":"≥20:1（典型值：MAVIC2）","工作时间":"侦测待机时间≥1.5h反制连续不间断工作时间≥15min","供电方式":"锂电池可更换","工作温度":"-20℃~+55℃","产品形态":"采用盾型设计","联网方式":"能够接入统一的无人机平台","操控方式":"10.1寸触屏操作","整机最大功耗":"480W","防护等级":"IP65","重量":"6.5KG"},"parameters_en":"{\"Detection Mode\":\"Provides both omni-directional and directional modes\",\"Algorithm Support\":\"Spectrum fingerprinting, Drone ID, Remote ID\",\"Detection Bands\":\"433M/800M/900M/1.4G/2.4G/5.2G/5.8G\",\"Accuracy\":\"≤30° (Directional); ≤0.5° (Protocol analysis)\",\"Max Detection Range\":\"≥3km (Open area environment)\",\"Jamming Bands\":\"800M/900M/1.2G/1.4G/1.6G/2.4G/5.2G/5.8G\",\"Max Jamming Distance\":\"≥2km (Line-of-sight)\",\"Jamming/Signal Ratio\":\"≥20:1 (Typical value: MAVIC 2)\",\"Operation Time\":\"Detection standby ≥1.5h; Continuous jamming ≥15min\",\"Power Supply\":\"Swappable lithium battery module\",\"Operating Temp\":\"-20°C to +55°C\",\"Product Form\":\"Shield-style design\",\"Connectivity\":\"UAV management platform integration\",\"Control Interface\":\"10.1-inch touch screen\",\"Max Power\":\"480W\",\"IP Rating\":\"IP65\",\"Weight\":\"6.5kg\"}","detail_html":"$33","detail_html_en":"<h4>Key Features</h4><ul><li>Integrated detection and jamming in one device, compact and portable for rapid deployment.</li><li>Real-time broadband spectrum sensing for automatic drone detection and identification.</li><li>Multi-band jamming covering mainstream drone flight control and image transmission frequencies.</li><li>Effective detection range up to 3km, effective jamming range up to 1.5km.</li><li>Supports multiple countermeasure modes: forced landing, return-to-home, signal disruption.</li><li>Built-in rechargeable lithium battery supporting continuous operation for over 2 hours.</li><li>Ruggedized waterproof design suitable for various harsh environments.</li><li>Intuitive operation interface, requires minimal training.</li></ul>","main_image":"/products/uav-systems/Portable-Integrated-Detection-&-Jamming-C-UAS.png","handle":"portable-integrated-detection-jamming-c-uas-basic","category_primary":"anti-drone-cuas","category_secondary":"Integrated Systems (察打一体/复合型反无设备)","category_tertiary":"Hand-held Jammer Systems (便携式/手持式干扰设备)","product_name_ru":"Интегрированная портативная система обнаружения и подавления БПЛА","summary_ru":"Портативная система C-UAS «все-в-одном» объединяет функции обнаружения, идентификации, позиционирования и нейтрализации. Устройство идеально подходит для мобильного использования благодаря легкому весу и защищенному исполнению. Система сканирует частоты на наличие сигнатур БПЛА и анализирует пакеты Drone ID / Remote ID для идентификации несанкционированных полетов, после чего блокирует сигналы управления и навигации, принуждая дрон к посадке или возврату.","key_application_ru":"Высокая портативность для оперативного развертывания; анализ протоколов Drone ID и Remote ID для точной идентификации; дальность подавления до 2 км; возможность точечного удара по конкретной цели в составе роя.","key_parameter_1_ru":"Дистанция подавления: ≥ 2 км","key_parameter_2_ru":"Вес: 6.5 кг","parameters_ru":"{\"Режим обнаружения\":\"Всенаправленное и направленное сканирование\",\"Алгоритмы\":\"Спектральные отпечатки, Drone ID, Remote ID\",\"Частоты обнаружения\":\"433M/800M/900M/1.4G/2.4G/5.2G/5.8G\",\"Точность\":\"≤ 30° (пеленгация); ≤ 0.5° (анализ протокола)\",\"Дальность обнаружения\":\"≥ 3 км (в чистом небе)\",\"Частоты подавления\":\"800M/900M/1.2G/1.4G/1.6G/2.4G/5.2G/5.8G\",\"Дальность подавления\":\"≥ 2 км (в условиях прямой видимости)\",\"Коэффициент подавления\":\"≥ 20:1 (цель: Mavic 2)\",\"Время работы\":\"Ожидание ≥ 1.5 ч; Активное подавление ≥ 15 мин\",\"Питание\":\"Сменный литиевый аккумуляторный модуль\",\"Температура\":\"-20℃ ~ +55℃\",\"Форм-фактор\":\"Дизайн «щит»\",\"Сетевой интерфейс\":\"Подключение к платформе управления C-UAS\",\"Управление\":\"Сенсорный дисплей 10.1 дюйма\",\"Мощность\":\"480 Вт\",\"Класс защиты\":\"IP65\",\"Вес\":\"6.5 кг\"}","detail_html_ru":"<h4>Особенности и преимущества</h4><ul><li>Интегрированная архитектура: Сочетание偵察 и подавления в одном компактном корпусе для быстрого реагирования.</li><li>Передовая идентификация: Поддержка анализа Drone ID и Remote ID позволяет не просто видеть сигнал, но и знать ID дрона и позицию пилота.</li><li>Высокая селективность: Возможность точечного воздействия на конкретный дрон DJI при наличии нескольких аппаратов в воздухе, не мешая остальным.</li><li>Мобильность и эргономика: Малый вес (6.5 кг) и удобный форм-фактор позволяют оператору быстро менять позицию.</li><li>Умное подавление: Блокировка всех популярных частот управления и видеосвязи, а также навигационных сигналов.</li><li>Полевая надежность: Пыле- и влагозащита по стандарту IP65 для работы в суровых условиях.</li></ul>","id":15,"raw_json":"$34","created_at":"2026-05-07 15:56:24","updated_at":"2026-05-07 15:56:24"},"locale":"ru","dict":"$e"}]}]]

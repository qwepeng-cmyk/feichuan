  },
  "parameters_en": {
    "Operating Frequency": "GPS L1/L2, GLONASS L1/L2, BDS B1/B2 (Customizable)",
    "Spoofing Radius": "1-30km (Adjustable)",
    "Jamming Radius": "1-3km (Adjustable)",
    "Effective Angle": "360° Horizontal",
    "Spoofing Response": "≤10s",
    "Power Consumption": "≤120W",
    "Startup Time": "≤30s",
    "Device Positioning": "GNSS location with coordinate reporting",
    "Deployment": "Stationary, Portable, or Vehicle-mounted",
    "Power Supply": "AC 90V-260V / DC 28V-36V",

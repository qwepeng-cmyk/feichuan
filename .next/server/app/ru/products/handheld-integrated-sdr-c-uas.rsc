d",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"100 МГц – 6000 МГц"}]]}],["$","tr","1",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Типы целей"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"DIY FPV (ELRS/TBS Crossfire), DJI, Autel, Parrot, WiFi-дроны"}]]}],["$","tr","2",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Дальность обнаружения"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"≥ 3 км (открытая местность); 0.5–1 км (город)"}]]}],["$","tr","3",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Точность пеленгации"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"10° (открытая местность)"}]]}],["$","tr","4",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Частоты подавления"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"400M / 800-900M / 1.2G / 1.4G / 1.5G / 2.4G / 5.2G / 5.8G (настраиваемо через SDR)"}]]}],["$","tr","5",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Углы подавления"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Направленное: 45° по горизонтали, 30° по вертикали"}]]}],["$","tr","6",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Дистанция подавления"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"≥ 2 км (общая); ≥ 1 км для мощных моделей (DJI Mavic 3 / Mini 4 Pro)"}]]}],["$","tr","7",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Время отклика"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"< 5 с"}]]}],["$","tr","8",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Дисплей"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"5-дюймовый тачскрин (статус, модель, батарея, логи)"}]]}],["$","tr","9",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Тип батареи"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Сменный литиевый аккумулятор"}]]}],["$","tr","10",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Автономность"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"≥ 15 мин (непрерывное полнодиапазонное излучение)"}]]}],["$","tr","11",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Вес"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"< 7 кг"}]]}],["$","tr","12",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Класс защиты"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"IP54"}]]}],["$","tr","13",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Рабочая температура"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"-30℃ ~ +55℃"}]]}],["$","tr","14",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Габариты"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"653 × 407 × 187 мм (±5 мм)"}]]}]]}]]}]}]]}]}],["$","section",null,{"id":"inquiry","className":"detail-section alt","style":{"padding":"80px 0","background":"#f8fafc"},"children":["$","div",null,{"className":"container","style":{"maxWidth":"1200px"},"children":["$","$a",null,{"fallback":["$","div",null,{"style":{"minHeight":"400px","background":"#f8fafc"}}],"children":["$","$L31",null,{"dict":"$e"}]}]}]}]]}]}]}],["$","div",null,{"className":"mobile_only","children":["$","$L32",null,{"product":{"product_name":"携式察打一体反无人机设备","product_name_en":"Handheld Integrated C-UAS System","summary":"察打一体手持设计，无任何外挂部件，结构紧凑，方便单兵携带。设备支持3km全向侦测、2km定向打击周围空域内的DIY FPV穿越机和常规无人机。其搭载SDR干扰技术，配备辅助瞄准系统，可长时间360°测向、解析、定位无人机，并实现全面压制，迫使无人机坠落、悬停、迫降或返航。 图1便携式察打一体反无人机设备","summary_en":"Featuring a handheld integrated design with no external components, this compact system is optimized for individual soldier portability. It supports 3km omnidirectional detection and 2km directional neutralization of DIY FPV drones and standard UAVs within the surrounding airspace. Powered by SDR jamming technology and an auxiliary aiming system, it enables long-duration 360° direction finding, protocol parsing, and positioning, achieving comprehensive suppression to force drones into falling, hovering, landing, or returning.","key_application":"应用领域：集无人机侦测和干扰技术于一体，可实现3km全向侦测及2km定向反制。；采用动态适配专用干扰码，可干扰DIY FPV穿越机和常规无人机，高效阻断无人机飞控、数/图传、导航等信号。；全频段干扰","key_application_en":"All-in-one detection and neutralization (3km detection/2km strike); SDR-based dynamic code jamming for DIY FPV and standard drones; auxiliary aiming system for real-time target data and pilot positioning; full-band coverage from 400MHz to 6GHz.","key_parameter_1":"干扰距离: ≥2km（干通比2:1），大疆Mini4 Pro/御3≥1km（干通比1:1），DIY FPV（ELRS/TBS Crossfire协议）","key_parameter_1_en":"Jamming Distance: ≥2km (J/S ratio 2:1); ≥1km for DJI Mini 4 Pro / Mavic 3; supports ELRS/TBS Crossfire protocols","key_parameter_2":"整机重量: <7kg","key_parameter_2_en":"Total Weight: <7kg","parameters":{"侦测频段":"100MHz~6000MHz","侦测机型":"DIY FPV 穿越机（ELRS/TBS Crossfire等协议）、常规无人机（大疆/道通/Parrot等）、WiFi无人机","侦测距离":"≥3km（空旷环境），0.5km~1km（城市环境）","测向精度":"10°（空旷环境）","干扰频段":"400MHz / 800~900MHz / 1.2GHz / 1.4GHz / 1.5GHz / 2.4GHz / 5.2GHz / 5.8GHz / 700MHz~3GHz软件自定义干扰通道","干扰角度":"定向干扰，水平45°，俯仰30°","干扰距离":"≥2km（干通比2:1），大疆Mini4 Pro/御3≥1km（干通比1:1），DIY FPV（ELRS/TBS Crossfire协议）","干扰响应时间":"<5s","屏幕显示":"5寸触摸屏显示：自检状态、无人机机型、干扰频段、日期时间、电池电量、干扰时长、操作日志等","电池类型":"可替换锂电池","单块电池续航":"≥15min（全频段发射开启）","整机尺寸":"653*407*187mm±5mm","整机重量":"<7kg","防护等级":"IP54","工作温度":"-30℃~+55℃"},"parameters_en":"{\"Detection Bands\":\"100MHz-6000MHz\",\"Target Types\":\"DIY FPV (ELRS/TBS), DJI, Autel, Parrot, WiFi drones\",\"Detection Range\":\"≥3km (Open area); 0.5-1km (Urban)\",\"Accuracy\":\"10° Direction Finding (Open area)\",\"Jamming Bands\":\"400M / 800M-900M / 1.2G / 1.4G / 1.5G / 2.4G / 5.2G / 5.8G (SDR Software Defined)\",\"Jamming Angle\":\"Directional: 45° H, 30° V\",\"Jamming Distance\":\"≥2km (General); ≥1km (DJI high-power models)\",\"Response Time\":\"<5s\",\"Display\":\"5-inch touchscreen (status, model, battery, logs)\",\"Battery Type\":\"Swappable lithium battery\",\"Battery Endurance\":\"≥15min (full-band emission)\",\"Dimensions\":\"653 * 407 * 187mm (±5mm)\",\"Weight\":\"<7kg\",\"IP Rating\":\"IP54\",\"Operating Temp\":\"-30°C to +55°C\"}","detail_html":"$33","detail_html_en":"<h4>Key Features</h4><ul><li>Handheld integrated detection and jamming system, ultra-portable for single-person operation.</li><li>Built-in SDR (Software Defined Radio) technology for real-time drone signal detection.</li><li>Multi-band jamming capability covering all mainstream drone communication frequencies.</li><li>Automatic detection-to-jamming workflow, minimizing operator workload.</li><li>Effective detection range up to 2km, effective jamming range up to 1.5km.</li><li>Ergonomic gun-type design with intuitive point-and-shoot operation.</li><li>Built-in rechargeable battery supporting continuous operation for extended periods.</li><li>Lightweight design under 5kg for comfortable extended use.</li></ul>","main_image":"/products/uav-systems/Portable-Integrated-C-UAS-Equipment.png","handle":"handheld-integrated-sdr-c-uas","category_primary":"anti-drone-cuas","category_secondary":"Integrated Systems (察打一体/复合型反无设备)","category_tertiary":"Hand-held Jammer Systems (便携式/手持式干扰设备)","product_name_ru":"Интегрированная портативная система C-UAS (SDR)","summary_ru":"Компактная носимая система «察打一体» (Обнаружение + Подавление) без внешних модулей, оптимизированная для использования одним бойцом. Обеспечивает всенаправленное обнаружение на расстоянии до 3 км и направленное подавление DIY FPV-дронов и стандартных БПЛА на дистанции до 2 км. Технология SDR (программно-определяемое радио) и система вспомогательного прицеливания позволяют точно пеленговать, идентифицировать и нейтрализовать цели, принуждая их к посадке или возврату.","key_application_ru":"Решение «все-в-одном» (3 км обнаружение / 2 км удар); динамическое кодовое подавление на базе SDR для борьбы с FPV-дронами; система помощи в прицеливании с данными о цели и пилоте; полный охват частот 400 МГц – 6 ГГц.","key_parameter_1_ru":"Дальность обнаружения: ≥ 3 км","key_parameter_2_ru":"Дистанция подавления: ≥ 2 км","parameters_ru":"{\"Диапазоны обнаружения\": \"100 МГц – 6000 МГц\", \"Типы целей\": \"DIY FPV (ELRS/TBS Crossfire), DJI, Autel, Parrot, WiFi-дроны\", \"Дальность обнаружения\": \"≥ 3 км (открытая местность); 0.5–1 км (город)\", \"Точность пеленгации\": \"10° (открытая местность)\", \"Частоты подавления\": \"400M / 800-900M / 1.2G / 1.4G / 1.5G / 2.4G / 5.2G / 5.8G (настраиваемо через SDR)\", \"Углы подавления\": \"Направленное: 45° по горизонтали, 30° по вертикали\", \"Дистанция подавления\": \"≥ 2 км (общая); ≥ 1 км для мощных моделей (DJI Mavic 3 / Mini 4 Pro)\", \"Время отклика\": \"< 5 с\", \"Дисплей\": \"5-дюймовый тачскрин (статус, модель, батарея, логи)\", \"Тип батареи\": \"Сменный литиевый аккумулятор\", \"Автономность\": \"≥ 15 мин (непрерывное полнодиапазонное излучение)\", \"Вес\": \"< 7 кг\", \"Класс защиты\": \"IP54\", \"Рабочая температура\": \"-30℃ ~ +55℃\", \"Габариты\": \"653 × 407 × 187 мм (±5 мм)\"}","detail_html_ru":"<h4>Особенности и преимущества</h4><ul><li>Интегрированная архитектура: Сочетание偵察 и подавления в одном корпусе позволяет мгновенно реагировать на угрозу без смены оборудования.</li><li>Умное подавление SDR: Использование динамических помеховых кодов позволяет эффективно бороться с самодельными FPV-дронами и нестандартными протоколами управления.</li><li>Полнодиапазонный охват: Возможность настройки любых частот в диапазоне до 6 ГГц для противодействия новым типам угроз.</li><li>Система целеуказания: Вспомогательный прицел отображает информацию о цели и расчетное положение пилота в реальном времени.</li><li>Эргономика и мобильность: Конструкция без внешних кабелей и блоков обеспечивает максимальную свободу действий оператора.</li></ul>","id":24,"raw_json":"$34","created_at":"2026-05-07 15:56:24","updated_at":"2026-05-07 15:56:24"},"locale":"ru","dict":"$e"}]}]]

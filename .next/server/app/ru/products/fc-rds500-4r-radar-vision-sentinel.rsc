р обнаруживает движение в любых условиях (дождь, снег, туман), а камера автоматически наводится для идентификации типа угрозы.</li><li>Интеллектуальный фильтр: Система эффективно отсеивает ложные тревоги, вызванные мелкими животными или растительностью.</li><li>Активная оборона: Встроенные средства воздействия позволяют предупредить нарушителя еще на подступах к охраняемой зоне.</li><li>Быстрое развертывание: Компактный размер и поддержка 4G/5G позволяют развернуть пост охраны в кратчайшие сроки без прокладки кабелей.</li><li>Сферический дизайн: Повышенная устойчивость к вибрациям и ветровым нагрузкам для четкости изображения в суровых условиях.</li></ul>"}]}]}],["$","section",null,{"id":"specs","className":"detail-section","style":{"padding":"80px 0","backgroundColor":"#fff"},"children":["$","div",null,{"className":"container","children":[["$","h2",null,{"className":"section-title","style":{"textAlign":"center","marginBottom":"50px","fontSize":"3.6rem","fontWeight":700},"children":"Технические характеристики"}],["$","div",null,{"style":{"border":"1px solid #eee","overflowX":"auto"},"children":["$","table",null,{"className":"spec-table","style":{"width":"100%","borderCollapse":"collapse","minWidth":"600px"},"children":[["$","thead",null,{"children":["$","tr",null,{"style":{"background":"#f4f7fa","color":"#333","borderBottom":"2px solid #315ba4"},"children":[["$","th",null,{"style":{"padding":"20px 30px","textAlign":"left","fontSize":"1.6rem","fontWeight":"bold"},"children":"Параметр"}],["$","th",null,{"style":{"padding":"20px 30px","textAlign":"left","fontSize":"1.6rem","fontWeight":"bold"},"children":"Описание"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Общие характеристики"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Обнаружение людей (≥500 м) и транспорта (≥700 м), круговой обзор 360°"}]]}],["$","tr","1",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Радар"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Тип 1T8R FMCW, точность дистанции ±0.75 м, точность угла ±1°, ширина луча 360° x 13°"}]]}],["$","tr","2",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Видимый свет"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"CMOS Starlight, 1920x1080, 43x оптический зум, обнаружение авто на 7 км, человека на 5 км"}]]}],["$","tr","3",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Оповещение"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Интегрированная сирена и стробоскоп, опционально — зеленый лазер ослепления"}]]}],["$","tr","4",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Поворотное устройство"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"360° непрерывно, скорость до 180°/с, 3000 пресетов, адаптация скорости под зум"}]]}],["$","tr","5",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Граничные вычисления"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Модуль ИИ 21 TOPS, 8 ГБ RAM, GPU 384 ядра, поддержка внешних вибродатчиков"}]]}],["$","tr","6",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Защита"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"IP66, рабочая температура -40°C ~ 60°C"}]]}],["$","tr","7",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Лазерная подсветка"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Длина волны 808 нм, дистанция 300 м, угол 1°~20°, без эффекта спекл-зернистости"}]]}],["$","tr","8",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Интерфейс связи"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"RJ45 / каскадирование по двойному LC оптоволокну"}]]}],["$","tr","9",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Питание"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"AC 220В ±20%; пиковое потребление ≤ 160 Вт"}]]}],["$","tr","10",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Габариты"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"315 × 300 × 480 мм (Д×Ш×В)"}]]}],["$","tr","11",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Монтаж"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Стационарная установка или временное крепление на штатив; рекомендуемая высота 3~5 м"}]]}],["$","tr","12",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Условия эксплуатации"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Рабочая температура -40°C ~ 60°C; влажность ≤ 95% RH; класс защиты IP66"}]]}],["$","tr","13",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Интеллектуальный анализ"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Детекция вторжения, пересечения линии, скопления, зависания; автосопровождение и связка с тревогой"}]]}]]}]]}]}]]}]}],["$","section",null,{"id":"inquiry","className":"detail-section alt","style":{"padding":"80px 0","background":"#f8fafc"},"children":["$","div",null,{"className":"container","style":{"maxWidth":"1200px"},"children":["$","$a",null,{"fallback":["$","div",null,{"style":{"minHeight":"400px","background":"#f8fafc"}}],"children":["$","$L31",null,{"dict":"$e"}]}]}]}]]}]}]}],["$","div",null,{"className":"mobile_only","children":["$","$L32",null,{"product":{"product_name":"FC-RDS500-4R型雷视融合系统","product_name_en":"FC-RDS500-4R Radar-Vision Fusion System","summary":"FC-RDS500-4R型雷视融合智能电子哨兵系统是一款广域全景型雷视融合设备产品，目标探测由四面阵雷达和云台摄像机配合实现，完美结合了雷达技术的主动探测性、高灵敏度与视频的可视性、智能化，极大提升了该系统在复杂环境下的检测率。","summary_en":"The FC-RDS500-4R radar-vision fusion intelligent electronic sentinel system is a wide-area panoramic radar-vision fusion equipment product. Target detection is realized by the cooperation of a four-sided array radar and a PTZ camera, perfectly combining the active detection and high sensitivity of radar technology with the visibility and intelligence of video, greatly improving the detection rate of the system in complex environments.","key_application_en":"Applications: Precision 24/7 perimeter security; radar-vision integrated surveillance; autonomous target identification and tracking; active deterrent and non-kinetic intervention; rapid tactical deployment.","parameters":{"整机性能":"1. 目标识别：行人、车辆\n2. 扫描范围：360°全方位覆盖\n3. 识别距离：行人（RCS 0.5㎡）≥500m，车辆（RCS 5㎡）≥700m","雷达":"1. 雷达类型：1发8收FMCW\n2. 测距精度：±0.75m\n3. 距离分辨率：1.5m\n4. 波束宽度：方位面（-6dB）：360°，俯仰面（-6dB）：13°\n5. 测角精度：±1°","高清可见光":"1. 作用距离：对中型车辆（4.6m×2.3m）：7000m，对站立人员（1.7m×0.5m）：5000m\n2. 传感器：背照式星光级CMOS\n3. 分辨率：1920×1080\n4. 照度：彩色0.01Lux，黑白0.001Lux\n5. 镜头焦距：7mm～300mm  43倍光学变倍，16倍数字变倍聚焦控制：手动/自动聚焦","激光照明":"1. 照明距离：300m\n2. 激光类型：全新高清泛光匀化光源，无散斑颗粒\n3. 照明角度：1°～20°","声光警示":"内部集成高音喇叭+爆闪灯，支持报警音自定义，支持更换绿光激光眩目","摄像机云台":"1. 旋转速度：水平：0.01°/s～180°/s；俯仰：0.01°/s～120°/s，支持焦距转速自适应\n2. 旋转角度：水平：360°连续旋转；俯仰：-90°～+90°\n3. 预置位巡航：预置位3000个，支持16条巡航路线，每条可支持256个预置位","智能化":"1. 智能分析：支持区域入侵检测、越界入侵检测、移动侦测、巡航检测以及徘徊检测、聚集检测、滞留检测、逆行检测等\n2. 自动跟踪：支持多场景跟踪、报警联动跟踪","接口协议":"1. 通信与控制：RJ45/双LC光纤级联","供电":"1. 供电范围：AC220V±20%\n2. 峰值功耗：≤160W","尺寸":"315mm×300mm×480mm（长×宽×高）","安装":"固定安装/三脚架临架式，建议安装高度为3～5m","环境适应性":"1. 工作温度：-40℃～60℃\n2. 工作湿度：≤95% RH\n3. 防护等级：IP66","边缘智能盒":"1. AI性能：21TOPS\n2. 内存：8GB\n3. 核心数：GPU 384核，CPU 6核\n4. 报警接入：支持外接RS485震动传感器\n5. 重量：≤5kg\n6. 尺寸：347mm×210mm×98mm\n7. 防护等级：IP65","定制化":"支持定制化功能开发"},"parameters_en":"$33","detail_html":"<h4>功能特点</h4><ul><li>采用雷达、摄像机复合探测，主、被动探测相结合，可满足昼夜全天候工作。</li><li>雷视智能融合，视觉融合雷达的目标信息，对防区内的感兴趣运动目标进行跟踪成像、智能识别。</li><li>探测警示一体化设计，支持高音喇叭+爆闪灯、支持选配绿光激光炫目，以便对入侵目标进行警示。</li><li>整机重量轻、尺寸小，易于安装维护，可选配4G/5G传输、光伏一体站，大幅提高建设时效，降低建设成本。</li><li>准球形结构设计，载荷能力强，转速快，抗风防抖性更好，成像更清晰。</li></ul>","detail_html_en":"<h4>Key Features</h4><ul><li>Adopts composite detection of radar and camera, combining active and passive detection, which can meet the requirements of day and night and all-weather work.</li><li>Radar-vision intelligent fusion, vision fuses the target information of radar, to track, image, and intelligently identify interested moving targets in the defense area.</li><li>Integrated design of detection and warning, supports tweeter + strobe light, supports optional green laser dazzling, in order to warn intruding targets.</li><li>The whole machine is light in weight and small in size, easy to install and maintain, supports optional 4G/5G transmission and photovoltaic integrated station, significantly improving construction efficiency and reducing construction costs.</li><li>Quasi-spherical structure design, strong load capacity, fast rotation speed, better wind resistance and anti-shake performance, clearer imaging.</li></ul>","main_image":"/products/surveillance/FC-RDS500-4R-Radar-Vision-Sentinel.png","handle":"fc-rds500-4r-radar-vision-sentinel","category_primary":"perimeter-intelligence","category_secondary":"Radar-Vision Integration Systems (雷视融合系统)","product_name_ru":"Интеллектуальная система Radar-Vision Fusion FC-RDS500-4R","summary_ru":"Система FC-RDS500-4R представляет собой панорамное решение, объединяющее радарную технологию с видеонаблюдением. Обнаружение целей осуществляется четырехсторонней радарной решеткой в паре с PTZ-камерой. Это сочетает активное сканирование и высокую чувствительность радара с визуальной верификацией и интеллектом видеоаналитики, значительно повышая точность обнаружения в сложных условиях.","key_application_ru":"Прецизионная круглосуточная охрана периметра; интегрированное наблюдение «радар-видео»; автономная идентификация и сопровождение целей; активное сдерживание; быстрое тактическое развертывание.","key_parameter_1_ru":"Обнаружение: Люди (≥500 м), транспорт (≥700 м)","key_parameter_2_ru":"Угол обзора: Круговой 360°","parameters_ru":"$34","detail_html_ru":"<h4>Особенности и преимущества</h4><ul><li>Синергия датчиков: Радар обнаруживает движение в любых условиях (дождь, снег, туман), а камера автоматически наводится для идентификации типа угрозы.</li><li>Интеллектуальный фильтр: Система эффективно отсеивает ложные тревоги, вызванные мелкими животными или растительностью.</li><li>Активная оборона: Встроенные средства воздействия позволяют предупредить нарушителя еще на подступах к охраняемой зоне.</li><li>Быстрое развертывание: Компактный размер и поддержка 4G/5G позволяют развернуть пост охраны в кратчайшие сроки без прокладки кабелей.</li><li>Сферический дизайн: Повышенная устойчивость к вибрациям и ветровым нагрузкам для четкости изображения в суровых условиях.</li></ul>","id":52,"key_parameter_1_en":"","key_parameter_2_en":"","raw_json":"$35","created_at":"2026-05-07 15:56:24","updated_at":"2026-05-07 15:56:24"},"locale":"ru","dict":"$e"}]}]]

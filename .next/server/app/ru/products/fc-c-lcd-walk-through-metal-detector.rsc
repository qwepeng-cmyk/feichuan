$","tr","6",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Внешние интерфейсы"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Опциональный серийный порт для интеграции с турникетами и системами видеонаблюдения"}]]}],["$","tr","7",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Питание"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"AC 90В - 250В (50/60Гц), мощность < 35 Вт"}]]}],["$","tr","8",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Вес"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"около 45 кг"}]]}],["$","tr","9",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Размеры прохода"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"2010(В) x 700(Ш) x 500(Г) мм"}]]}]]}]]}]}]]}]}],["$","section",null,{"id":"inquiry","className":"detail-section alt","style":{"padding":"80px 0","background":"#f8fafc"},"children":["$","div",null,{"className":"container","style":{"maxWidth":"1200px"},"children":["$","$a",null,{"fallback":["$","div",null,{"style":{"minHeight":"400px","background":"#f8fafc"}}],"children":["$","$L31",null,{"dict":"$e"}]}]}]}]]}]}]}],["$","div",null,{"className":"mobile_only","children":["$","$L32",null,{"product":{"product_name":"FC-C (液晶型) 12区通过式金属探测门","product_name_en":"Walk-Through Metal Detector FC-C (LCD, 12-Zone)","summary":"FC-C 金属探测门是一款集成电磁兼容设计与高强度抗震性能的安全检查设备。该设备具备极高的探测灵敏度和抗干扰能力，能够精准定位各类管制刀具、枪支等危险金属物品。配备直观的液晶操作界面与智能客流量计数系统，广泛应用于监狱、法院、学校、电子企业、港口枢纽及大型演唱会等需要严密安保的高人流量公共场所。","summary_en":"The FC-C metal detection gate is a high-security inspection device that integrates advanced electromagnetic compatibility design with robust vibration-resistant performance. Offering exceptional sensitivity and anti-interference capabilities, it precisely identifies and locates dangerous metallic items such as controlled knives and firearms. Featuring an intuitive LCD interface and an intelligent passenger counting system, it is widely utilized for professional security screening in high-traffic environments including prisons, courts, schools, electronics manufacturing, transportation hubs, and large-scale concerts.","key_application":"应用领域：FC-C (液晶型) 通过式金属探测门；具备高灵敏度与抗干扰能力，适用于管制刀具和枪支等危险物品的安全检查，广泛应用于各类高人流量公共场所。","key_application_en":"Advanced LCD interface with 12 overlapping detection zones; high-speed digital scanning for zero blind spots; networked capability for up to 20 gates; waterproof and fireproof PVC construction.","key_parameter_1":"探测区域: 12个相互重叠的探测区域","key_parameter_1_en":"Detection Zones: 12 overlapping zones","key_parameter_2":"产品材质: 特种工艺制造 PVC 合成材料","key_parameter_2_en":"Material: Specialized PVC composite","parameters":{"探测防区":"12个互相重叠的防区，支持多区位同时报警与精确定位","灵敏度调节":"0-1000 级灵敏度，可排除皮带扣、钥匙等干扰，最高可探至一枚大头针","抗干扰能力":"采用 2000 级 DSP 数字过滤技术，具有极佳的磁电兼容性与抗震能力","网络接口":"预留网络接口，支持最多20台门设备并网由电脑统一集中管理","材质性能":"PVC 合成材质，具有卓越的防水、防火及抗撞击物理特性","报警计数":"智能化客流量与报警计数器，实时统计进出人次与报警频率","连动接口":"可选配串行通讯接口，与闸机、安防监控系统实现自动化联动","外接电源":"AC 90V - 250V (50/60Hz)，功率 <35W","整体重量":"约 45kg","通道尺寸":"(mm) 2010(高) x 700(宽) x 500(深)"},"parameters_en":"{\"Detection Zones\":\"12 overlapping zones with multi-target simultaneous alarm capability\",\"Sensitivity\":\"0-1000 levels; can filter personal items; maximum detection of a safety pin\",\"Signal Processing\":\"2000-level DSP digital filtering for extreme E-M interference resistance\",\"Connectivity\":\"Built-in network interface for centralized management of up to 20 gates\",\"Construction\":\"High-durability PVC composite; waterproof, fireproof, and shock-resistant\",\"Traffic Statistics\":\"Smart bi-directional traffic counter and alarm statistics logger\",\"External Interface\":\"Optional serial interface for gate and surveillance integration\",\"Power Supply\":\"AC 90V - 250V (50/60Hz), power <35W\",\"Weight\":\"Approx. 45kg\",\"Channel Dimensions\":\"2010(H) x 700(W) x 500(D) mm\"}","detail_html":"$33","detail_html_en":"$34","main_image":"/products/security/FC-C-(LCD)-Walk-Through-Metal-Detector.png","handle":"fc-c-lcd-walk-through-metal-detector","category_primary":"security-screening","category_secondary":"Safety Inspection Gates (安检门/探测门)","category_tertiary":"Walk-Through Metal Detectors (通过式金属探测门)","product_name_ru":"Арочный металлодетектор FC-C (ЖК-экран, 12 зон)","summary_ru":"FC-C (ЖК-тип) — это досмотровое оборудование, сочетающее в себе передовой дизайн электромагнитной совместимости и высокую виброустойчивость. Обладает исключительной чувствительностью и помехоустойчивостью, позволяя точно определять местоположение холодного и огнестрельного оружия. Оснащен интуитивно понятным ЖК-интерфейсом и интеллектуальной системой подсчета посетителей. Широко используется в тюрьмах, судах, школах и на стадионах.","key_application_ru":"ЖК-интерфейс с 12 зонами обнаружения; цифровое сканирование без слепых зон; возможность объединения в сеть до 20 устройств; корпус из ПВХ.","key_parameter_1_ru":"Зоны обнаружения: 12 независимых зон","key_parameter_2_ru":"Материал: Специализированный ПВХ-композит","parameters_ru":"{\"Зоны обнаружения\":\"12 перекрывающихся зон с одновременной индикацией нескольких целей\",\"Регулировка чувствительности\":\"0-1000 уровней; исключение помех от пряжек ремней; обнаруживает мелкие предметы (булавки)\",\"Обработка сигналов\":\"Цифровая фильтрация DSP (2000 уровней) для экстремальной защиты от помех\",\"Сетевые возможности\":\"Сетевой интерфейс для централизованного управления до 20 рамками через ПК\",\"Материалы\":\"Высокопрочный композит ПВХ; водонепроницаемый, огнестойкий и ударопрочный\",\"Статистика\":\"Умный двунаправленный счетчик проходов и лог тревог\",\"Внешние интерфейсы\":\"Опциональный серийный порт для интеграции с турникетами и системами видеонаблюдения\",\"Питание\":\"AC 90В - 250В (50/60Гц), мощность < 35 Вт\",\"Вес\":\"около 45 кг\",\"Размеры прохода\":\"2010(В) x 700(Ш) x 500(Г) мм\"}","detail_html_ru":"<h4>Особенности и преимущества</h4><ul><li>Улучшенные материалы: ПВХ-композит со специальными водонепроницаемыми чехлами на ножках для долгой службы.</li><li>ЖК-монитор 7 дюймов: Интуитивно понятная настройка параметров и мониторинг состояния в реальном времени.</li><li>Точная локализация: Светодиоды на стойках и графическое отображение зон на экране позволяют мгновенно увидеть, где спрятан металл.</li><li>Сетевое управление: Возможность удаленного контроля группы металлодетекторов через единую систему.</li><li>Настройка звука: Регулируемая громкость и тон (длинный/средний/короткий) для разных условий эксплуатации.</li><li>Безопасность: Полное соответствие международным стандартам защиты здоровья (безопасно для беременных и носителей кардиостимуляторов).</li></ul>","id":37,"raw_json":"$35","created_at":"2026-05-07 15:56:24","updated_at":"2026-05-07 15:56:24"},"locale":"ru","dict":"$e"}]}]]

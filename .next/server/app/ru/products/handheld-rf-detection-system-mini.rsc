    "电池": "及续航：1800mAh (≤3h) / 5000mAh (≤8h); 支持更换",
    "开机启动时间": "15S",
    "设备尺寸": "135mm*69mm*50mm (L*W*H)",
    "屏幕尺寸": "1.77寸",

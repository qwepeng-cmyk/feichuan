  "parameters_en": {
    "Frequency Range": "400MHz-6GHz (Default: 400M/800M/900M/1.2G/1.4G/2.4G/5.2G/5.8G)",
    "Detection Distance": "≤2km",
    "Response Time": "≤3s",
    "Detection Principle": "Spectral Recognition",
    "Direction Function": "360° Detection (Non-directional)",
    "Operation": "Keypad controlled; volume/backlight adjustment; logs viewing",
    "Battery & Endurance": "1800mAh (≤3h) / 5000mAh (≤8h); Swappable",
    "Startup Time": "15 seconds",
    "Dimensions": "135mm * 69mm * 50mm (L*W*H)",
    "Screen Size": "1.77-inch",

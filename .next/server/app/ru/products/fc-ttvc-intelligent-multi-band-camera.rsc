"},"children":[["$","a",null,{"href":"#inquiry","className":"btn-cta","style":{"background":"#ff9800","color":"#fff","borderRadius":"4px","fontSize":"2rem","flex":1,"height":"60px","border":"none","cursor":"pointer","display":"flex","alignItems":"center","justifyContent":"center","fontWeight":"700","textDecoration":"none"},"children":"Запросить КП"}],["$","a",null,{"href":"https://wa.me/+8613761974616","className":"btn-cta","style":{"background":"#ff9800","color":"#fff","borderRadius":"4px","fontSize":"2rem","flex":1,"height":"60px","display":"flex","alignItems":"center","justifyContent":"center","border":"none","fontWeight":"700","textDecoration":"none"},"children":"WhatsApp"}]]}]]}]]}]}]}],["$","section",null,{"className":"product-intro-section","style":{"paddingBottom":"60px","background":"#fff"},"children":["$","div",null,{"className":"container","children":["$","div",null,{"className":"product-intro-text","style":{"fontSize":"1.8rem","color":"#444","lineHeight":"1.8","borderTop":"1px solid #eee","paddingTop":"40px"},"children":"Камеры серии FC-TTVC разработаны на основе 6-го поколения технологий HD-видеонаблюдения для удаленного мониторинга. Встроенные алгоритмы обнаружения очагов тепла и задымления позволяют автоматически находить пламя, технику и людей на больших дистанциях, что делает их идеальными для защиты лесов, пастбищ, угольных шахт и складов зерна."}]}]}],["$","$L2f",null,{"items":[{"id":"overview","label":"Обзор"},{"id":"specs","label":"Технические характеристики"},{"id":"inquiry","label":"Контакты"}]}],["$","section",null,{"id":"features","className":"detail-section alt","style":{"padding":"100px 0","backgroundColor":"#f8fafc"},"children":["$","div",null,{"className":"container","children":["$","$L30",null,{"className":"rich-content auto-grid","html":"<h4>Особенности и преимущества</h4><ul><li>Взаимное дополнение спектров: Быстрый поиск целей в ИК-диапазоне и детальное изучение в видимом свете.</li><li>Тяжелое исполнение: Усиленный ЧПУ-привод обеспечивает плавность хода и отсутствие дрожания при максимальном увеличении.</li><li>Умная противопожарная защита: Специализированные алгоритмы обнаруживают возгорания на ранних стадиях, минимизируя ущерб.</li><li>Надежность: Функция самодиагностики и защиты от засветки гарантируют долгий срок службы в автономном режиме.</li><li>Расширяемость: Возможность подключения лазерных дальномеров и модулей ГНСС для точного определения координат целей.</li></ul>"}]}]}],["$","section",null,{"id":"specs","className":"detail-section","style":{"padding":"80px 0","backgroundColor":"#fff"},"children":["$","div",null,{"className":"container","children":[["$","h2",null,{"className":"section-title","style":{"textAlign":"center","marginBottom":"50px","fontSize":"3.6rem","fontWeight":700},"children":"Технические характеристики"}],["$","div",null,{"style":{"border":"1px solid #eee","overflowX":"auto"},"children":["$","table",null,{"className":"spec-table","style":{"width":"100%","borderCollapse":"collapse","minWidth":"600px"},"children":[["$","thead",null,{"children":["$","tr",null,{"style":{"background":"#f4f7fa","color":"#333","borderBottom":"2px solid #315ba4"},"children":[["$","th","0",{"style":{"padding":"20px 30px","textAlign":"left","fontSize":"1.6rem","fontWeight":"bold","borderRight":"1px solid #eee"},"children":"Параметр"}],["$","th","1",{"style":{"padding":"20px 30px","textAlign":"left","fontSize":"1.6rem","fontWeight":"bold","borderRight":"1px solid #eee"},"children":"Значение"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td","0",{"style":{"padding":"20px 30px","fontSize":"1.5rem","borderRight":"1px solid #eee"},"children":"Тепловизор"}],["$","td","1",{"style":{"padding":"20px 30px","fontSize":"1.5rem","borderRight":"1px solid #eee"},"children":"VOx детектор 6-го поколения, 640x512, NETD < 40мК, объективы с зумом от 25 до 300 мм"}]]}],["$","tr","1",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td","0",{"style":{"padding":"20px 30px","fontSize":"1.5rem","borderRight":"1px solid #eee"},"children":"Видимый свет"}],["$","td","1",{"style":{"padding":"20px 30px","fontSize":"1.5rem","borderRight":"1px solid #eee"},"children":"CMOS Starlight, ультра-низкая освещенность, объективы до 860 мм, моторизованный зум"}]]}],["$","tr","2",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td","0",{"style":{"padding":"20px 30px","fontSize":"1.5rem","borderRight":"1px solid #eee"},"children":"Лазерная подсветка"}],["$","td","1",{"style":{"padding":"20px 30px","fontSize":"1.5rem","borderRight":"1px solid #eee"},"children":"Технология GHT-III (без散斑颗粒), дистанция до 3000 м, цифровое управление углом луча DSS"}]]}],["$","tr","3",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td","0",{"style":{"padding":"20px 30px","fontSize":"1.5rem","borderRight":"1px solid #eee"},"children":"Интеллект"}],["$","td","1",{"style":{"padding":"20px 30px","fontSize":"1.5rem","borderRight":"1px solid #eee"},"children":"Детекция дыма и огня, распознавание людей/животных/транспорта/судов, сопровождение целей"}]]}],["$","tr","4",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td","0",{"style":{"padding":"20px 30px","fontSize":"1.5rem","borderRight":"1px solid #eee"},"children":"Поворотное устройство"}],["$","td","1",{"style":{"padding":"20px 30px","fontSize":"1.5rem","borderRight":"1px solid #eee"},"children":"360° по горизонтали, -45° ~ +45° по вертикали, точность ±0.1°, адаптивная скорость"}]]}],["$","tr","5",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td","0",{"style":{"padding":"20px 30px","fontSize":"1.5rem","borderRight":"1px solid #eee"},"children":"Защита"}],["$","td","1",{"style":{"padding":"20px 30px","fontSize":"1.5rem","borderRight":"1px solid #eee"},"children":"IP66, защита матрицы от солнечных ожогов, работа до -40°C"}]]}],["$","tr","6",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td","0",{"style":{"padding":"20px 30px","fontSize":"1.5rem","borderRight":"1px solid #eee"},"children":"Вес"}],["$","td","1",{"style":{"padding":"20px 30px","fontSize":"1.5rem","borderRight":"1px solid #eee"},"children":"45 кг (включая PTZ)"}]]}],["$","tr","7",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td","0",{"style":{"padding":"20px 30px","fontSize":"1.5rem","borderRight":"1px solid #eee"},"children":"Интерфейсы"}],["$","td","1",{"style":{"padding":"20px 30px","fontSize":"1.5rem","borderRight":"1px solid #eee"},"children":"Сеть: 1× RJ45, 10/100 Base-T; Питание: AC/DC 24В, защита от переполюсовки"}]]}],["$","tr","8",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td","0",{"style":{"padding":"20px 30px","fontSize":"1.5rem","borderRight":"1px solid #eee"},"children":"Энергопотребление"}],["$","td","1",{"style":{"padding":"20px 30px","fontSize":"1.5rem","borderRight":"1px solid #eee"},"children":"≤ 180 Вт суммарно"}]]}],["$","tr","9",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td","0",{"style":{"padding":"20px 30px","fontSize":"1.5rem","borderRight":"1px solid #eee"},"children":"Условия эксплуатации"}],["$","td","1",{"style":{"padding":"20px 30px","fontSize":"1.5rem","borderRight":"1px solid #eee"},"children":"Рабочая температура -40°C ~ 60°C; хранение -45°C ~ 70°C; влажность ≤ 90% RH; класс защиты IP66"}]]}],["$","tr","10",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td","0",{"style":{"padding":"20px 30px","fontSize":"1.5rem","borderRight":"1px solid #eee"},"children":"Кастомизация"}],["$","td","1",{"style":{"padding":"20px 30px","fontSize":"1.5rem","borderRight":"1px solid #eee"},"children":"Поддержка разработки пользовательских функций"}]]}]]}]]}]}]]}]}],["$","section",null,{"id":"inquiry","className":"detail-section alt","style":{"padding":"80px 0","background":"#f8fafc"},"children":["$","div",null,{"className":"container","style":{"maxWidth":"1200px"},"children":["$","$a",null,{"fallback":["$","div",null,{"style":{"minHeight":"400px","background":"#f8fafc"}}],"children":["$","$L31",null,{"dict":"$e"}]}]}]}]]}]}]}],["$","div",null,{"className":"mobile_only","children":["$","$L32",null,{"product":{"handle":"fc-ttvc-intelligent-multi-band-camera","product_name":"FC-TTVC 系列智能多波段摄像机","product_name_en":"FC-TTVC Series Intelligent Multi-Band Camera","product_name_ru":"Интеллектуальная мультиспектральная камера серии FC-TTVC","category_primary":"perimeter-intelligence","category_secondary":"Multi-Band EO/IR PTZ Cameras (多波段光电转台 / 智能多波段摄像机)","main_image":"/products/surveillance/FC-TTVC-Series-Smart-Multi-Band-Camera.png","summary":"FC-TTVC系列智能多波段摄像机，是基于第六代高清可见光成像技术，为远程昼夜监控领域设计开发的摄像机。内置智能热点、烟火检测算法，可自动探测出远距离火焰、车辆、人员等热源目标，非常适合如森林防火、畜牧草原、煤矿、大型粮仓等防火自动化远程监控预警。","summary_en":"The FC-TTVC series intelligent multi-band camera is a camera designed and developed for the field of remote day and night monitoring based on the sixth-generation high-definition visible light imaging technology. Built-in intelligent hotspot and fire and smoke detection algorithms can automatically detect long-distance heat source targets such as flames, vehicles, and personnel, which is very suitable for automated remote monitoring and early warning of fire prevention such as forest fire prevention, animal husbandry grasslands, coal mines, and large granaries.","summary_ru":"Камеры серии FC-TTVC разработаны на основе 6-го поколения технологий HD-видеонаблюдения для удаленного мониторинга. Встроенные алгоритмы обнаружения очагов тепла и задымления позволяют автоматически находить пламя, технику и людей на больших дистанциях, что делает их идеальными для защиты лесов, пастбищ, угольных шахт и складов зерна.","key_application":"应用领域：FC-TTVC 系列智能多波段摄像机；森林防火与工业设施防火自动化监控预警；远程昼夜全天候目标快速搜索与识别；重点区域的全维度光电安全监测。","key_application_en":"Applications: Forest and industrial fire prevention; long-range 24/7 target search and identification; all-dimensional EO/IR security monitoring for critical infrastructure.","key_application_ru":"Противопожарный мониторинг лесов и промышленных объектов; круглосуточный поиск и идентификация целей; всесторонний оптико-электронный контроль критической инфраструктуры.","key_parameter_1":"探测技术: 第六代非制冷焦平面 VOx 热成像 + 星光级可见光","key_parameter_1_en":"Sensing Technology: 6th Gen Uncooled VOx Thermal Imaging + Starlight Visible Light","key_parameter_1_ru":"Технология: VOx 6-го поколения + CMOS Starlight","key_parameter_2":"激光补光距离: 1000m - 3000m (可选)","key_parameter_2_en":"Laser Illumination Range: 1,000m - 3,000m (Optional)","key_parameter_2_ru":"Дистанция лазера: 1000–3000 м","detail_html":"<h4>功能特点</h4><ul><li>多光谱优势互补，实现昼夜全时段、全天候大范围目标快速搜索和近距离细节观察。</li><li>采用重载数控云台，360°连续旋转观察，运转平稳，图像抖动小，焦距转速自适应，目标定位精准。</li><li>高度智能：支持热点告警、烟火告警、温度检测；支持区域入侵检测；支持车、船、人、动物检测、分类、识别。</li><li>支持自诊断自恢复，支持强光保护、防太阳灼伤，支持多组态场景模式，大幅提升使用体验、降低使用成本。</li><li>可扩展激光测距、北斗/GPS等传感器，组成多功能态势感知的远距离监测设备。</li></ul>","detail_html_en":"<h4>Key Features</h4><ul><li>Multi-spectral complementary advantages, achieving day and night all-time, all-weather wide-range target rapid search and close-range detail observation.</li><li>Adopts heavy-duty CNC PTZ, 360° continuous rotation observation, smooth operation, small image jitter, focal length and speed adaptive, precise target positioning.</li><li>Highly intelligent: supports hotspot alarm, fire and smoke alarm, temperature detection; supports region intrusion detection; supports vehicle, ship, human, animal detection, classification, and recognition.</li><li>Supports self-diagnosis and self-recovery, supports strong light protection, anti-sunburn, supports multi-configuration scene modes, significantly improving user experience and reducing usage costs.</li><li>Expandable with sensors such as laser ranging and Beidou/GPS to form a multi-functional situational awareness long-distance monitoring device.</li></ul>","detail_html_ru":"<h4>Особенности и преимущества</h4><ul><li>Взаимное дополнение спектров: Быстрый поиск целей в ИК-диапазоне и детальное изучение в видимом свете.</li><li>Тяжелое исполнение: Усиленный ЧПУ-привод обеспечивает плавность хода и отсутствие дрожания при максимальном увеличении.</li><li>Умная противопожарная защита: Специализированные алгоритмы обнаруживают возгорания на ранних стадиях, минимизируя ущерб.</li><li>Надежность: Функция самодиагностики и защиты от засветки гарантируют долгий срок службы в автономном режиме.</li><li>Расширяемость: Возможность подключения лазерных дальномеров и модулей ГНСС для точного определения координат целей.</li></ul>","parameters":[["参数","值"],["型号","FC-TTVC系列智能多波段摄像机"],["热成像","1. 探测器：第六代非制冷焦平面阵列VOx探测器\n2. 分辨率：640×512\n3. 波长：8～14μm\n4. NETD：40mK（@25℃ F1.0）\n5. 镜头焦距：25mm~75mm/31mm~155mm/37mm~185mm/23mm~230mm/30mm~300mm\n6. 镜头控制：电动变倍；手动/自动聚焦"],["可见光","1. 传感器类型:背照式超低照度星光级CMOS\n2. 最低照度：彩色:0.0005Lux；黑白：0.0001Lux；0Lux（IRON）\n3. 镜头焦距：7mm～330mm/11mm～860mm/12.5mm～750mm\n4. 镜头控制：百万高清电动变焦；手动/自动聚焦"],["激光光源","1. 激光类型：全新GHT-III高清泛光超匀化光源专利技术\n2. 照射距离：1000米~3000米可选\n3. 波长：810nm激光\n4. 照度角度：1°～20°/0.5°～20°/0.3°～20°可选, DSS数字化步进照明角度控制技术"],["智能功能","1. 智能分析：支持入侵侦测、越界侦测、进入/离开区域侦测、移动侦测等功能\n2. 支持单场景跟踪/支持多场景跟踪/支持全景跟踪/支持报警联动跟踪\n3. 报警管理：支持报警抓拍上传"],["云台","1. 范围：水平0～360°，俯仰-45°～+45°\n2. 转速：水平0.01°/S～30°/S，俯仰0.01°/S ～15°/S，支持镜头焦距速度自适应功能\n3. 精度：±0.1°"],["接口","1. 网络接口：1路RJ45,10/100 Base-T自适应\n2. 供电：AC/DC24V，防反接保护"],["功耗","1. 总功耗：≤180W"],["重量","1. 总重量： 45kg(含云台)"],["环境指标","1. 工作温度：-40℃～60℃\n2. 储存温度：-45℃～70℃\n3. 工作湿度：≤90% RH\n4. 防护等级：IP66"],["定制化","1. 支持定制化功能开发"]],"parameters_en":"$33","parameters_ru":"[[\"Параметр\", \"Значение\"], [\"Тепловизор\", \"VOx детектор 6-го поколения, 640x512, NETD < 40мК, объективы с зумом от 25 до 300 мм\"], [\"Видимый свет\", \"CMOS Starlight, ультра-низкая освещенность, объективы до 860 мм, моторизованный зум\"], [\"Лазерная подсветка\", \"Технология GHT-III (без散斑颗粒), дистанция до 3000 м, цифровое управление углом луча DSS\"], [\"Интеллект\", \"Детекция дыма и огня, распознавание людей/животных/транспорта/судов, сопровождение целей\"], [\"Поворотное устройство\", \"360° по горизонтали, -45° ~ +45° по вертикали, точность ±0.1°, адаптивная скорость\"], [\"Защита\", \"IP66, защита матрицы от солнечных ожогов, работа до -40°C\"], [\"Вес\", \"45 кг (включая PTZ)\"], [\"Интерфейсы\", \"Сеть: 1× RJ45, 10/100 Base-T; Питание: AC/DC 24В, защита от переполюсовки\"], [\"Энергопотребление\", \"≤ 180 Вт суммарно\"], [\"Условия эксплуатации\", \"Рабочая температура -40°C ~ 60°C; хранение -45°C ~ 70°C; влажность ≤ 90% RH; класс защиты IP66\"], [\"Кастомизация\", \"Поддержка разработки пользовательских функций\"]]","id":53,"raw_json":"$34","created_at":"2026-05-07 15:56:24","updated_at":"2026-05-08 10:29:01"},"locale":"ru","dict":"$e"}]}]]

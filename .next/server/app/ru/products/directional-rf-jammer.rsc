0°, Вертикальный: 50°-80°"}]]}],["$","tr","7",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Энергопотребление"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"< 600 Вт"}]]}],["$","tr","8",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Вес"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"≤ 41 кг"}]]}],["$","tr","9",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Класс защиты"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"IP66"}]]}],["$","tr","10",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Питание"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"AC 220 В"}]]}],["$","tr","11",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Режим работы"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Поддержка непрерывной эксплуатации 24/7 на открытом воздухе"}]]}],["$","tr","12",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Рабочая температура"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"-40°C ~ +60°C"}]]}],["$","tr","13",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Габариты"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"470 × 250 × 700 мм"}]]}]]}]]}]}]]}]}],["$","section",null,{"id":"inquiry","className":"detail-section alt","style":{"padding":"80px 0","background":"#f8fafc"},"children":["$","div",null,{"className":"container","style":{"maxWidth":"1200px"},"children":["$","$a",null,{"fallback":["$","div",null,{"style":{"minHeight":"400px","background":"#f8fafc"}}],"children":["$","$L31",null,{"dict":"$e"}]}]}]}]]}]}]}],["$","div",null,{"className":"mobile_only","children":["$","$L32",null,{"product":{"product_name":"无线电干扰设备（定向）","product_name_en":"Directional RF Jammer","summary":"定向无线电干扰设备通过发射无线电信号，在特定区域形成电磁信号屏蔽，切断无人机的控制链路、图传链路和导航链路，使无人机返航、迫降、悬停，无法进入管控区域。 图1无线电干扰设备（定向）","summary_en":"The directional RF jammer forms electromagnetic signal shielding in a specific area by emitting radio signals. It cuts off the control link, video transmission link, and navigation link of the drone, forcing it to return, land, or hover, thereby preventing it from entering the controlled airspace.","key_application":"应用领域：干扰类型多；设备可切断常见消费级、行业级无人机、航模机、穿越机、DIY改装无人机的导航信号、遥控信号、图传信号，从而达到对无人机反制管控的效果。；导航干扰全","key_application_en":"Multi-target jamming (consumer, industrial, FPV, DIY drones); comprehensive navigation interference (GPS, GLONASS, Beidou, Galileo); selectable frequency bands with 24/7 all-weather stability.","key_parameter_1":"干扰距离: ≥3km（根据环境和机型不同会有一定差异）","key_parameter_1_en":"Interference Range: ≥3km (Variable based on environment and target)","key_parameter_2":"工作频段: 400MHz、800MHz、900MHz、1.2GHz、1.4GHz、1.5GHz、2.4GHz、5.8GHz、5.1GHZ-5.9GHZ、","key_parameter_2_en":"Operating Frequency: 400MHz - 5.9GHz","parameters":{"工作频段":"400MHz、800MHz、900MHz、1.2GHz、1.4GHz、1.5GHz、2.4GHz、5.8GHz、5.1GHZ-5.9GHZ、","干扰模式":"具备驱离模式和迫降模式","干扰距离":"≥3km（根据环境和机型不同会有一定差异）","干扰响应时间":"≤3s","云台旋转角度":"水平角度：360°，垂直角度：-10°~+60°","云台速度":"水平：0.02°~60°/s，俯仰：0.01°~12°/s","天线角度":"水平角度：30°~50°垂直角度：50°~80°","整机功耗":"＜600W","整机尺寸":"470mm*250mm*700mm(L*W*H)","整机重量":"≤41kg","工作温度":"-40°C~+60℃","防护等级":"IP66","电源":"AC220V","连续工作时间":"支持户外7×24小时使用"},"parameters_en":"{\"Frequency Range\":\"400MHz, 800MHz, 900MHz, 1.2GHz, 1.4GHz, 1.5GHz, 2.4GHz, 5.8GHz, 5.1-5.9GHz\",\"Jamming Mode\":\"Repel mode and Forced Landing mode\",\"Jamming Distance\":\"≥3km (Environment dependent)\",\"Response Time\":\"≤3s\",\"PTZ Angle\":\"360° Horizontal; -10° to +60° Vertical\",\"PTZ Speed\":\"H: 0.02°-60°/s; V: 0.01°-12°/s\",\"Antenna Angle\":\"H: 30°-50°; V: 50°-80°\",\"Power Consumption\":\"<600W\",\"Dimensions\":\"470mm * 250mm * 700mm\",\"Weight\":\"≤41kg\",\"Operating Temp\":\"-40°C to +60℃\",\"IP Rating\":\"IP66\",\"Power Supply\":\"AC 220V\",\"Continuous Work\":\"24/7 Outdoor use supported\"}","detail_html":"<h4>功能特点</h4><ul><li>干扰类型多</li><li>设备可切断常见消费级、行业级无人机、航模机、穿越机、DIY改装无人机的导航信号、遥控信号、图传信号，从而达到对无人机反制管控的效果。</li><li>导航干扰全</li><li>处置导航频率范围包含GPS、GLONASS、北斗、伽利略等不同类型导航系统。</li><li>干扰频段可选</li><li>能单独或同时发射各频段的干扰信号。</li><li>适应性强</li><li>适用于复杂各种环境，防水、防尘。</li><li>稳定干扰</li><li>设备可长时间干扰，发出的干扰信号无频偏。</li><li>转台跟随</li><li>高速转台驱动，结合侦测定位设备实现360°目标跟随。</li><li>基本参数</li><li>工作频段</li><li>400MHz、800MHz、900MHz、1.2GHz、1.4GHz、1.5GHz、2.4GHz、5.8GHz、5.1GHZ-5.9GHZ、</li><li>干扰模式</li><li>具备驱离模式和迫降模式</li><li>干扰距离</li><li>≥3km（根据环境和机型不同会有一定差异）</li><li>干扰响应时间</li><li>云台旋转角度</li><li>水平角度：360°，垂直角度：-10°~+60°</li><li>云台速度</li><li>水平：0.02°~60°/s，俯仰：0.01°~12°/s</li><li>天线角度</li><li>水平角度：30°~50°垂直角度：50°~80°</li><li>整机功耗</li><li>＜600W</li><li>整机尺寸</li><li>470mm*250mm*700mm(L*W*H)</li><li>整机重量</li><li>≤41kg</li><li>工作温度</li><li>-40°C~+60℃</li><li>防护等级</li><li>IP66</li><li>AC220V</li><li>连续工作时间</li><li>支持户外7×24小时使用</li></ul>","detail_html_en":"<h4>Key Features</h4><ul><li>Directional high-gain antenna design, concentrated energy for longer effective range.</li><li>Covers mainstream drone flight control and navigation frequency bands including 1.5GHz/2.4GHz/5.8GHz.</li><li>Effective jamming range up to 3km (varies by environment and target).</li><li>Forces target drone to land, return to home, or lose control.</li><li>Modular design, supports flexible frequency band configuration based on threat scenarios.</li><li>All-weather outdoor design with IP66 protection rating.</li></ul>","main_image":"/products/anti-drone/Directional-RF-Jammer.png","handle":"directional-rf-jammer","category_primary":"anti-drone-cuas","category_secondary":"Interference & Defeat (干扰与反制)","category_tertiary":"RF Jamming Systems [Directional & Omni] (无线电干扰设备 - 定向/全向)","product_name_ru":"Направленная система радиочастотного подавления БПЛА","summary_ru":"Направленная система подавления излучает радиосигналы для создания защитного электромагнитного барьера в определенном секторе. Она блокирует каналы управления, передачи видео и навигации, заставляя БПЛА вернуться в точку взлета, совершить аварийную посадку или зависнуть на месте, предотвращая вторжение на охраняемую территорию.","key_application_ru":"Подавление широкого спектра целей (потребительские, промышленные, FPV, DIY дроны); полная блокировка навигации (GPS, ГЛОНАСС, Beidou, Galileo); выбор частотных диапазонов; стабильная работа 24/7.","key_parameter_1_ru":"Дистанция подавления: ≥ 3 км","key_parameter_2_ru":"Рабочие частоты: 400 МГц – 5.9 ГГц","parameters_ru":"{\"Рабочие частоты\": \"400 МГц, 800 МГц, 900 МГц, 1.2 ГГц, 1.4 ГГц, 1.5 ГГц, 2.4 ГГц, 5.8 ГГц, 5.1-5.9 ГГц\", \"Режимы подавления\": \"Режим принудительного возврата (Repel) и режим посадки (Forced Landing)\", \"Дистанция подавления\": \"≥ 3 км (в зависимости от условий и типа цели)\", \"Время отклика\": \"≤ 3 с\", \"Углы поворота (ОПУ)\": \"Горизонтальный: 360°, Вертикальный: -10° ~ +60°\", \"Скорость поворота\": \"Горизонтальная: до 60°/с, Вертикальная: до 12°/с\", \"Угол луча антенны\": \"Горизонтальный: 30°-50°, Вертикальный: 50°-80°\", \"Энергопотребление\": \"< 600 Вт\", \"Вес\": \"≤ 41 кг\", \"Класс защиты\": \"IP66\", \"Питание\": \"AC 220 В\", \"Режим работы\": \"Поддержка непрерывной эксплуатации 24/7 на открытом воздухе\", \"Рабочая температура\": \"-40°C ~ +60°C\", \"Габариты\": \"470 × 250 × 700 мм\"}","detail_html_ru":"<h4>Особенности и преимущества</h4><ul><li>Многодиапазонность: Блокировка всех популярных каналов управления и навигации, включая ГЛОНАСС и Beidou.</li><li>Гибкость тактики: Оператор может выбирать отдельные частоты для подавления или задействовать весь спектр сразу.</li><li>Интеллектуальное наведение: Высокоскоростное опорно-поворотное устройство позволяет автоматически следовать за целью по командам от системы обнаружения.</li><li>Всепогодность: Защита IP66 и широкий температурный диапазон для использования в любых климатических зонах.</li><li>Стабильность сигнала: Отсутствие дрейфа частоты при длительной непрерывной работе.</li></ul>","id":9,"raw_json":"$33","created_at":"2026-05-07 15:56:24","updated_at":"2026-05-07 15:56:24"},"locale":"ru","dict":"$e"}]}]]

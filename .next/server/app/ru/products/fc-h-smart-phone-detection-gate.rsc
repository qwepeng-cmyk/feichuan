idth":"45%","fontSize":"1.5rem"},"children":"Рабочая частота"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"Саморегулирующаяся в зависимости от условий установки"}]]}],["$","tr","26",{"style":{"background":"#fff","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Внешние размеры"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"не более 2310(В) × 820(Ш) × 710(Г) мм"}]]}],["$","tr","27",{"style":{"background":"#fafafa","borderBottom":"1px solid #eee"},"children":[["$","td",null,{"style":{"padding":"20px 30px","fontWeight":"bold","width":"45%","fontSize":"1.5rem"},"children":"Размеры прохода"}],["$","td",null,{"style":{"padding":"20px 30px","fontSize":"1.5rem"},"children":"не более 2010(В) × 710(Ш) × 608(Г) мм"}]]}]]}]]}]}]]}]}],["$","section",null,{"id":"inquiry","className":"detail-section alt","style":{"padding":"80px 0","background":"#f8fafc"},"children":["$","div",null,{"className":"container","style":{"maxWidth":"1200px"},"children":["$","$a",null,{"fallback":["$","div",null,{"style":{"minHeight":"400px","background":"#f8fafc"}}],"children":["$","$L31",null,{"dict":"$e"}]}]}]}]]}]}]}],["$","div",null,{"className":"mobile_only","children":["$","$L32",null,{"product":{"product_name":"智慧手机探测门FC-H","product_name_en":"Smart Phone Detection Gate FC-H","summary":"FC- H 智慧手机探测门，采用领先电磁波信号探测技术，手机探测门可有效分辨出是否携带待机、关机、开机、移除电池、移除SIM卡等任何状态下的手机，以及移动硬盘，笔记本电脑，Ipad、 数码相机、摄像机等电子产品，可应用于学校、保密场所等重要场景。 具备针对电子设备探测功能的“电子设备检测门”，非仅能探测金属的“金属安检门”。 全方位智慧识别：多角度手机放置精准检测，探测准确率大于99%。","summary_en":"The FC-H Smart Phone Detection Gate utilizes leading electromagnetic wave signal detection technology to effectively distinguish mobile phones in any state—including standby, power-off, power-on, battery removed, or SIM card removed. It also detects other electronic products like mobile hard drives, laptops, iPads, digital cameras, and camcorders. Designed for schools and confidential locations, it serves as a specialized 'electronic device detection gate' rather than a standard metal detector. It features 360-degree intelligent recognition with an accuracy rate exceeding 99%.","key_application":"应用领域：智慧手机探测门FC-H；FC- H    智慧手机探测门，采用领先电磁波信号探测技术，手机探测门可有效分辨出是否携带待机、关机、开机、移除电池、移除SIM卡等任何状态下的手机，以及移动硬盘，笔记本电脑，Ipad、 数码相机、摄像机等电子产品，可应用于学校、保密场所等重要场景。；全方位智慧识别：多角度手机放置精准检测，探测准确率大于99%。","key_application_en":"High-precision electronic device detection for schools and high-security venues; identifies phones in all states (off/on/disassembled); multi-zone audio-visual alarms with 99%+ accuracy; automatic daily item filtering (belts, keys, etc.)","key_parameter_1":"外形尺寸: (mm) 不大于2310(高)×820(宽)×710(深)","key_parameter_1_en":"External Dimensions: ≤ 2310(H) x 820(W) x 710(D) mm","key_parameter_2":"通道尺寸: (mm) 不大于2010(高)×710(宽)×608(深)","key_parameter_2_en":"Passage Dimensions: ≤ 2010(H) x 710(W) x 608(D) mm","parameters":{"全方位智慧识别":"多角度手机放置精准检测，探测准确率大于99%。","多区位报警功能":"支持多个探测区分头颈、头顶、两侧腋下及上躯干、腰部及臀部、大腿内外侧、小腿、 双脚、脚踝等区域并声光报警。","可探测电子设备位置":"探测到电子设备后报警、记录、抓拍记录查询，大屏显示，数据导出。","智慧识别":"可自动识别排除日常用品进行手机检测。","linux系统":"稳定性强，扩展功能广泛。","宽体门板设计":"外壳稳定、坚固、耐用、不变形。","自动校准":"设备配有自动校准模式，安装时根据场地自动校准，屏蔽干扰。","信号图形化":"探测信号图形化波形展示，设备状态一目了然。","液晶屏幕显示":"采用13.3寸液晶屏显示，各类信息直观清晰。","USB 升级":"应用软件可通过USB 升级。","模块化组件设计":"运输、维护方便快捷","区位显示":"产品分成6防区，可疑物能在每个区域准确显示。","统计人数":"主界面自动显示更新通过人数和报警人数。","四侧定位灯":"门体四侧均带有LED灯，能直观的通过定位灯显示违禁品所在区域，视角可达360。","声光报警":"具有语音报警、灯条闪光报警功能。","高性能CPU":"采用6核芯高性能芯片，主频超过1.8GHz。","遥控操作":"使用无线鼠标键盘对参数进行设置，参数可以设置密码保护，非授权人员无法进行操作","安全保护":"符合安全国际标准，对心脏起搏器佩戴者，孕妇，磁性介质等无害","指示灯调试":"具有指示灯手动调试功能，可快速排除故障","操作系统":"LINUX","运输重量":"约90kg","功耗":"<40W","工作温度":"-10℃~40℃","工作湿度":"95%,无冷凝","外接电源":"187V~242V,50/60HZ","工作频率":"根据安装环境自行调节","外形尺寸":"(mm) 不大于2310(高)×820(宽)×710(深)","通道尺寸":"(mm) 不大于2010(高)×710(宽)×608(深)"},"parameters_en":"$33","detail_html":"<h4>功能特点</h4><ul><li>日用品过滤：</li><li>排除皮带扣、眼镜、钢笔、文具盒等日常用品进行手机检测。</li><li>区位显示：产品分成6防区，可疑物能在每个区域准确显示。</li><li>统计人数：主界面自动显示更新通过人数和报警人数。</li><li>四侧定位灯：门体四侧均带有LED灯，能直观的通过定位灯显示违禁品所在区域，视角可达360。</li><li>声光报警：具有语音报警、灯条闪光报警功能。</li><li>高性能CPU:采用6核芯高性能芯片，主频超过1.8GHz。</li><li>遥控操作：使用无线鼠标键盘对参数进行设置，参数可以设置密码保护，非授权人员无法进行操作</li><li>安全保护：符合安全国际标准，对心脏起搏器佩戴者，孕妇，磁性介质等无害</li><li>指示灯调试：具有指示灯手动调试功能，可快速排除故障</li><li>技术标准</li><li>技术标准</li><li>严格执行GB15210-2018《通过式金属探测门通用技术规范》国家标准。</li></ul>","detail_html_en":"$34","main_image":"/products/security/FC-H-Smart-Phone-Detection-Gate.png","handle":"fc-h-smart-phone-detection-gate","category_primary":"security-screening","category_secondary":"Safety Inspection Gates (安检门/探测门)","category_tertiary":"Smart Phone Detection Gates (智能手机探测门)","product_name_ru":"Интеллектуальная рамка обнаружения смартфонов FC-H","summary_ru":"Интеллектуальная рамка обнаружения смартфонов FC-H использует передовую технологию обнаружения электромагнитных сигналов для эффективного выявления мобильных телефонов в любом состоянии: в режиме ожидания, выключенных, включенных, со снятым аккумулятором или извлеченной SIM-картой. Она также обнаруживает другие электронные устройства, такие как переносные жесткие диски, ноутбуки, iPad, цифровые фотоаппараты и видеокамеры. Предназначена для использования в школах, на режимных объектах и в других важных зонах. Это специализированная «рамка для обнаружения электронных устройств», а не просто стандартный металлодетектор. Обладает функцией всестороннего интеллектуального распознавания с точностью обнаружения более 99%.","key_application_ru":"Высокоточное обнаружение электронных устройств для школ и объектов с повышенными требованиями к безопасности; идентификация телефонов в любом состоянии (выключены/включены/разобраны); многозонная светозвуковая сигнализация с точностью 99%+; автоматическая фильтрация предметов повседневного обихода (ремни, ключи и т.д.).","key_parameter_1_ru":"Внешние размеры: ≤ 2310(В) x 820(Ш) x 710(Г) мм","key_parameter_2_ru":"Размеры прохода: ≤ 2010(В) x 710(Ш) x 608(Г) мм","parameters_ru":"$35","detail_html_ru":"<h4>Особенности и преимущества</h4><ul><li>Фильтрация личных вещей: Исключение пряжек ремней, очков, ручек, пеналов и других предметов при обнаружении телефонов.</li><li>Зональное отображение: Разделение на 6 зон обнаружения для точного указания места нахождения объекта.</li><li>Статистика: Автоматическое обновление данных о количестве проходов и тревог на главном экране.</li><li>360-градусная индикация: Светодиоды на всех четырех сторонах корпуса рамки.</li><li>Светозвуковая тревога: Настраиваемые голосовые сообщения и световые сигналы.</li><li>Мощный процессор: 6-ядерная система для мгновенной обработки сигналов.</li><li>Дистанционное управление: Беспроводная настройка с защитой доступа.</li><li>Безопасность для здоровья: Сертифицировано для использования беременными женщинами и людьми с медицинскими имплантами.</li><li>Технический стандарт: Строгое соответствие государственному стандарту GB15210-2018.</li></ul>","id":26,"raw_json":"$36","created_at":"2026-05-07 15:56:24","updated_at":"2026-05-07 15:56:24"},"locale":"ru","dict":"$e"}]}]]

# Copy these values into .env.deploy.local on the deploy machine.
# .env.deploy.local is ignored by Git.
DEPLOY_USER=root
DEPLOY_HOST=43.129.170.171
DEPLOY_PATH=/www/wwwroot/n-tet.com
ZONE_NAME=n-tet.com

# When running from /mnt/d/fc in WSL, source is mirrored here and built with Linux node_modules.
DEPLOY_BUILD_ROOT=/Users/mattchyi/Documents/Project/fc

# WSL upload reliability: clamp the route interface MTU during deploy, then restore it.
# Set DEPLOY_MTU=0 to disable, or DEPLOY_NETWORK_INTERFACE=eth0 to override auto-detection.
DEPLOY_MTU=1280

# 0 means unlimited. Set a KiB/s value only when intentional throttling is needed.
DEPLOY_RSYNC_BWLIMIT=0

# Prefer SSH keys. If password login is still used, install sshpass in WSL and set:
SSHPASS=replace-with-server-password

# Use a token scoped to Zone:Read and Cache Purge for n-tet.com.
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-api-token
